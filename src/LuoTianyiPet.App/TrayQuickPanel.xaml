<Window x:Class="LuoTianyiPet.App.TrayQuickPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="洛天依桌宠快捷面板"
        Width="324"
        Height="456"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FF32B9F2" />
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#FF0878A9" />
        <SolidColorBrush x:Key="TextBrush" Color="#FF173F54" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FF6B8390" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="QuickActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="50" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#FFF6FBFD" />
            <Setter Property="BorderBrush" Value="#FFD8E8EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#FFEAF7FC" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#8832B9F2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#FFDDF2FA" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource QuickActionButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="TextButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#1532B9F2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#2032B9F2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickToggleRowStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="RowSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" />
                                <Grid Grid.Column="1" Width="42" Height="22" VerticalAlignment="Center">
                                    <Border x:Name="ToggleTrack"
                                            Background="#FFD7E4EA"
                                            BorderBrush="#FFB4C6CF"
                                            BorderThickness="1"
                                            CornerRadius="11" />
                                    <Ellipse x:Name="ToggleThumb"
                                             Width="16"
                                             Height="16"
                                             Margin="3"
                                             HorizontalAlignment="Left"
                                             Fill="White">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="3"
                                                              Color="#FF173F54"
                                                              Opacity="0.2"
                                                              ShadowDepth="1" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowSurface" Property="Background" Value="#0F32B9F2" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RowSurface" Property="Background" Value="#1832B9F2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScaleSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="4"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Background="#FFD7E6ED"
                                    CornerRadius="2" />
                            <Track x:Name="PART_Track"
                                   Margin="8,0"
                                   VerticalAlignment="Center"
                                   IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4"
                                                        VerticalAlignment="Center"
                                                        Background="{StaticResource PrimaryBrush}"
                                                        CornerRadius="2" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="ThumbSurface"
                                                         Fill="White"
                                                         Stroke="{StaticResource PrimaryBrush}"
                                                         StrokeThickness="3">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="5"
                                                                          Color="#FF305A6E"
                                                                          Opacity="0.2"
                                                                          ShadowDepth="1" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbSurface" Property="Fill" Value="#FFEAF8FD" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12"
            Padding="16,14"
            Background="#FFFBFDFE"
            BorderBrush="#FFD8E8EF"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              Color="#FF173F54"
                              Direction="270"
                              Opacity="0.22"
                              ShadowDepth="6" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="48"
                        Height="48"
                        Margin="0,0,11,0"
                        Background="#1832B9F2"
                        CornerRadius="14">
                    <Image Margin="3"
                           Source="/assets/app/luotianyi-pet.png"
                           Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="洛天依桌宠" />
                        <StackPanel Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#FF2ACB88" />
                            <TextBlock Margin="4,0,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="9.5"
                                       Text="陪伴中" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="CompanionText"
                               Margin="0,5,0,0"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontSize="10.5"
                               Text="我一直在这里哦～"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <Button x:Name="OpenSettingsButton"
                    Grid.Row="1"
                    Margin="0,13,0,12"
                    AutomationProperties.Name="打开完整设置"
                    Style="{StaticResource QuickActionButtonStyle}"
                    Click="OnOpenSettingsClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Text="&#xE713;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="打开完整设置" />
                        <TextBlock Margin="0,2,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="9.5"
                                   Text="调整全部桌宠功能" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="13"
                               Text="&#xE76C;" />
                </Grid>
            </Button>

            <StackPanel Grid.Row="2">
                <TextBlock Margin="4,0,0,4"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="9.5"
                           FontWeight="SemiBold"
                           Text="快捷开关" />
                <ToggleButton x:Name="TopmostToggle"
                              AutomationProperties.Name="始终置顶"
                              Style="{StaticResource QuickToggleRowStyle}"
                              Click="OnTopmostToggleClick">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="始终置顶" />
                        <TextBlock Margin="0,2,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="9"
                                   Text="保持天依显示在普通窗口上方" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="StartupToggle"
                              AutomationProperties.Name="开机自启动"
                              Style="{StaticResource QuickToggleRowStyle}"
                              Click="OnStartupToggleClick">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="开机自启动" />
                        <TextBlock Margin="0,2,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="9"
                                   Text="登录 Windows 后自动见面" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="4,12,4,0">
                <Grid>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="显示大小" />
                    <TextBlock x:Name="ScaleValueText"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="100%" />
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button AutomationProperties.Name="缩小桌宠"
                            Style="{StaticResource SmallButtonStyle}"
                            Click="OnDecreaseScaleClick"
                            Content="−" />
                    <Slider x:Name="ScaleSlider"
                            Grid.Column="1"
                            Margin="7,0"
                            AutomationProperties.Name="桌宠显示大小"
                            IsMoveToPointEnabled="True"
                            SmallChange="5"
                            LargeChange="10"
                            TickFrequency="5"
                            IsSnapToTickEnabled="True"
                            Style="{StaticResource ScaleSliderStyle}"
                            ValueChanged="OnScaleValueChanged"
                            PreviewMouseLeftButtonUp="OnScalePreviewMouseLeftButtonUp"
                            KeyUp="OnScaleKeyUp" />
                    <Button Grid.Column="2"
                            AutomationProperties.Name="放大桌宠"
                            Style="{StaticResource SmallButtonStyle}"
                            Click="OnIncreaseScaleClick"
                            Content="+" />
                </Grid>
                <Grid Margin="43,1,43,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="8" Text="50%" />
                    <TextBlock Grid.Column="1" HorizontalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="8" Text="100%" />
                    <TextBlock Grid.Column="2" HorizontalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="8" Text="150%" />
                    <TextBlock Grid.Column="3" HorizontalAlignment="Right"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="8" Text="200%" />
                </Grid>
                <Button Margin="0,0,-5,0"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="恢复默认显示大小"
                        Style="{StaticResource TextButtonStyle}"
                        Click="OnResetScaleClick"
                        Content="恢复 100%" />
            </StackPanel>

            <Grid Grid.Row="6" Margin="0,9,0,0">
                <Button x:Name="ExitButton"
                        Height="40"
                        Foreground="#FF9B4452"
                        Background="#0FB85060"
                        BorderBrush="#28B85060"
                        AutomationProperties.Name="让天依休息"
                        Style="{StaticResource QuickActionButtonStyle}"
                        Click="OnExitClick">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   Text="&#xE708;" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Text="让天依休息" />
                    </StackPanel>
                </Button>
                <Grid x:Name="ExitConfirmationPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Text="确定让天依休息吗？" />
                    <Button Grid.Column="1"
                            Margin="4,0"
                            AutomationProperties.Name="取消退出"
                            Style="{StaticResource TextButtonStyle}"
                            Click="OnCancelExitClick"
                            Content="取消" />
                    <Button Grid.Column="2"
                            Margin="2,0,0,0"
                            Foreground="#FFB23A4D"
                            AutomationProperties.Name="确认退出桌宠"
                            Style="{StaticResource TextButtonStyle}"
                            Click="OnConfirmExitClick"
                            Content="退出" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
