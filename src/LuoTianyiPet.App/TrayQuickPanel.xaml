<Window x:Class="LuoTianyiPet.App.TrayQuickPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="洛天依桌宠菜单" Width="264" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        Deactivated="OnDeactivated" PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources><ResourceDictionary Source="QuickPanelResources.xaml" /></Window.Resources>
    <Border Style="{StaticResource PanelSurface}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="8,0,0,10">
                <Image Width="30" Height="30" Source="/assets/app/luotianyi-pet.png" />
                <TextBlock Text="洛天依桌宠" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <Button x:Name="ShowPetButton" Content="显示 / 召回天依" Click="OnShowPetClick" />
            <Button x:Name="HidePetButton" Content="暂时隐藏" Click="OnHidePetClick" ToolTip="从托盘左键即可找回天依" />
            <Border Height="1" Background="#D8E8EF" Margin="10,6" />
            <Button x:Name="OpenSettingsButton" Content="完整设置…" Click="OnOpenSettingsClick" />
            <Button x:Name="ExitButton" Content="让天依休息（退出）" Foreground="#9B4452" Click="OnExitClick" />
        </StackPanel>
    </Border>
</Window>
