<Window x:Class="LuoTianyiPet.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="洛天依桌宠设置"
        Icon="/assets/app/luotianyi-pet.ico"
        Width="660"
        Height="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FFF2F7FB"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Loaded="OnLoaded">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FF32B9F2" />
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#FF0878A9" />
        <SolidColorBrush x:Key="TextBrush" Color="#FF173F54" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A8173F54" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="SettingsTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="60" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="#FCFFFFFF"
                                    BorderBrush="#267ECDEB"
                                    BorderThickness="0,0,0,1">
                                <TabPanel Margin="22,0"
                                          HorizontalAlignment="Left"
                                          IsItemsHost="True" />
                            </Border>
                            <ContentPresenter Grid.Row="1"
                                              Margin="22,18,22,0"
                                              ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#B2173F54" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="0,0,8,0">
                            <Border x:Name="TabSurface"
                                    MinWidth="112"
                                    Padding="16,0"
                                    Background="Transparent"
                                    CornerRadius="12,12,0,0">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  ContentSource="Header" />
                            </Border>
                            <Border x:Name="SelectionLine"
                                    Width="68"
                                    Height="3"
                                    VerticalAlignment="Bottom"
                                    Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="2"
                                    Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#1032B9F2" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}" />
                                <Setter TargetName="TabSurface" Property="Background" Value="#1532B9F2" />
                                <Setter TargetName="SelectionLine" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="15" />
            <Setter Property="Background" Value="#FCFFFFFF" />
            <Setter Property="BorderBrush" Value="#347ECDEB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18"
                                      Color="#FF589CB8"
                                      Direction="270"
                                      Opacity="0.09"
                                      ShadowDepth="3" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PageDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,15" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="RowSurface"
                                MinHeight="60"
                                Padding="14,9"
                                Background="Transparent"
                                CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Margin="0,0,18,0"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                                <Grid Grid.Column="1"
                                      Width="44"
                                      Height="24"
                                      VerticalAlignment="Center">
                                    <Border x:Name="ToggleTrack"
                                            Background="#FFD7E4EA"
                                            BorderBrush="#70A4B9C4"
                                            BorderThickness="1"
                                            CornerRadius="12" />
                                    <Ellipse x:Name="ToggleThumb"
                                             Width="18"
                                             Height="18"
                                             Margin="3"
                                             HorizontalAlignment="Left"
                                             Fill="White">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="4"
                                                              Color="#FF234C60"
                                                              Opacity="0.22"
                                                              ShadowDepth="1" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowSurface" Property="Background" Value="#1032B9F2" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RowSurface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="OptionDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}" />
            <Setter Property="Background" Value="#1832B9F2" />
            <Setter Property="BorderBrush" Value="#5532B9F2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.74" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}" />
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="MinWidth" Value="126" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#FF1AA6E1" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#FFF7FBFD" />
            <Setter Property="BorderBrush" Value="#667ECDEB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FFF7FBFE" />
                <GradientStop Offset="0.6" Color="#FFF1F8FC" />
                <GradientStop Offset="1" Color="#FFEAF5FB" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="62" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="23,12"
                Background="#FCFFFFFF"
                BorderBrush="#267ECDEB"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="50"
                        Height="50"
                        Margin="0,0,13,0"
                        Background="#1832B9F2"
                        CornerRadius="15">
                    <Image Margin="3"
                           Source="/assets/app/luotianyi-pet.png"
                           Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="洛天依桌宠" />
                        <TextBlock Margin="9,4,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   Text="设置" />
                    </StackPanel>
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10.5"
                               Text="调整桌面陪伴、音乐互动与消息提醒" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    Style="{StaticResource SettingsTabControlStyle}"
                    AutomationProperties.Name="设置分类">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,7,0" VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets" FontSize="17"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                   Text="&#xE713;" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                   Text="常规" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="常规设置" />
                            <TextBlock Style="{StaticResource PageDescriptionStyle}"
                                       Text="管理桌宠的启动、显示和日常互动方式。" />
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <CheckBox x:Name="StartWithWindowsCheckBox"
                                              AutomationProperties.Name="登录 Windows 后自动启动洛天依桌宠">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource OptionTitleStyle}" Text="开机自动启动" />
                                            <TextBlock Style="{StaticResource OptionDescriptionStyle}"
                                                       Text="登录 Windows 后自动运行桌宠" />
                                        </StackPanel>
                                    </CheckBox>
                                    <Separator Margin="14,0" Background="#257ECDEB" />
                                    <CheckBox x:Name="AlwaysOnTopCheckBox"
                                              AutomationProperties.Name="桌宠始终置顶">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource OptionTitleStyle}" Text="始终置顶" />
                                            <TextBlock Style="{StaticResource OptionDescriptionStyle}"
                                                       Text="保持桌宠显示在其他普通窗口上方" />
                                        </StackPanel>
                                    </CheckBox>
                                    <Separator Margin="14,0" Background="#257ECDEB" />
                                    <CheckBox x:Name="FullBodyStyleCyclingCheckBox"
                                              AutomationProperties.Name="允许双击循环三种桌宠外观">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource OptionTitleStyle}" Text="双击切换外观" />
                                            <TextBlock Style="{StaticResource OptionDescriptionStyle}"
                                                       Text="双击桌宠时在三种外观间循环；关闭后固定当前外观" />
                                        </StackPanel>
                                    </CheckBox>
                                    <Separator Margin="14,0" Background="#257ECDEB" />
                                    <CheckBox x:Name="DesktopFileTreatsCheckBox"
                                              AutomationProperties.Name="启用吃包子功能">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource OptionTitleStyle}" Text="吃包子功能" />
                                            <TextBlock Style="{StaticResource OptionDescriptionStyle}"
                                                       Text="桌面删除后追包，或把文件拖到桌宠后移入回收站" />
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="1" Height="120" Margin="28,4,20,0">
                            <StackPanel Margin="18,0,0,14"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom">
                                <TextBlock Foreground="#8B4E9DBD"
                                           FontFamily="Microsoft YaHei UI"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           LineHeight="28"
                                           Text="今天也，&#x0a;一起加油吧~" />
                            </StackPanel>
                            <Image Width="132"
                                   Height="120"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Source="/assets/ui/settings-encouragement.png"
                                   Stretch="Uniform"
                                   Opacity="0.94" />
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,7,0" VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets" FontSize="17"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                   Text="&#xE8D6;" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                   Text="音乐" />
                    </StackPanel>
                </TabItem.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="音乐互动" />
                    <TextBlock Style="{StaticResource PageDescriptionStyle}"
                               Text="选择网易云音乐播放时，桌宠持续展示的听歌动作。" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource OptionTitleStyle}" Text="播放动画" />
                            <TextBlock Margin="0,4,0,13"
                                       Style="{StaticResource OptionDescriptionStyle}"
                                       Text="随机模式会在开始播放、继续播放或切歌时重新抽取" />
                            <Border Background="#FFF7FBFD" BorderBrush="#667ECDEB"
                                    BorderThickness="1" CornerRadius="11" ClipToBounds="True">
                                <ComboBox x:Name="MusicAnimationSelectionComboBox"
                                          AutomationProperties.Name="音乐播放动画选择"
                                          BorderThickness="0" />
                            </Border>
                            <Border Margin="0,14,0,0" Padding="13,11"
                                    Background="#1032B9F2" CornerRadius="11">
                                <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10.5" TextWrapping="Wrap"
                                           Text="网易云独立音量继续通过桌宠播放控制岛调节，不会修改其它应用或系统主音量。以后新增的听歌循环动作会继续加入此列表。" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,7,0" VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets" FontSize="17"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                   Text="&#xE7F4;" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                   Text="通知" />
                    </StackPanel>
                </TabItem.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="消息提醒" />
                    <TextBlock Style="{StaticResource PageDescriptionStyle}"
                               Text="只显示 QQ / 微信来源，以及系统通知明确提供的联系人或群名。" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <CheckBox x:Name="MessageReminderCheckBox"
                                      AutomationProperties.Name="启用 QQ 和微信消息来源提醒">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource OptionTitleStyle}" Text="QQ / 微信消息提醒" />
                                    <TextBlock Style="{StaticResource OptionDescriptionStyle}"
                                               Text="来源应用不在前台时，在桌宠旁显示提醒" />
                                </StackPanel>
                            </CheckBox>
                            <Border Margin="0,8,0,14" Padding="13,11"
                                    Background="#1032B9F2" CornerRadius="11">
                                <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10.5" TextWrapping="Wrap"
                                           Text="桌宠不会读取、显示、保存或记录消息正文；标题结构不明确时只显示应用来源。" />
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="NotificationAccessStatusText"
                                           Margin="2,0,16,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10.5" TextWrapping="Wrap"
                                           Text="正在检查 Windows 通知访问状态……" />
                                <Button x:Name="NotificationAccessButton" Grid.Column="1"
                                        AutomationProperties.Name="授权 Windows 通知访问"
                                        Click="OnRequestNotificationAccessClick"
                                        Content="授权访问" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,7,0" VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets" FontSize="17"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                   Text="&#xE946;" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                   Text="关于" />
                    </StackPanel>
                </TabItem.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="关于洛天依桌宠" />
                    <TextBlock Style="{StaticResource PageDescriptionStyle}"
                               Text="一只留在 Windows 桌面上陪伴你的本地桌宠。" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="116" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Width="94" Height="94"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Source="/assets/app/luotianyi-pet.png"
                                   Stretch="Uniform" />
                            <StackPanel Grid.Column="1" Margin="6,3,0,0">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="洛天依桌宠" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11"
                                           Text="本地运行 · Windows 10/11 · 普通用户权限" />
                                <TextBlock Margin="0,14,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10.5" LineHeight="18" TextWrapping="Wrap"
                                           Text="角色动画、设置和交互数据保存在本机。桌宠不会读取聊天正文，也不会把拖入的文件永久删除；文件操作仅请求移入 Windows 回收站。" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Padding="22,10"
                Background="#F8FFFFFF"
                BorderBrush="#267ECDEB"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Foreground="#7A173F54"
                           FontSize="10.5"
                           Text="更改会在保存后立即生效" />
                <Button Grid.Column="1"
                        AutomationProperties.Name="保存桌宠设置"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnSaveClick"
                        Content="保存并关闭" />
            </Grid>
        </Border>
    </Grid>
</Window>
