<Window x:Class="LuoTianyiPet.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="洛天依桌宠设置"
        Width="660"
        MaxHeight="760"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5FBFF"
        Loaded="OnLoaded">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF174E68" />
        </Style>
        <Style x:Key="SettingCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#5566CCFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FF174E68" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,7,0,7" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF39BDF5" />
            <Setter Property="BorderBrush" Value="#FF169DD8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PreviewChoiceStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,2,16">
            <TextBlock FontSize="23" FontWeight="Bold" Text="洛天依桌宠设置" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="#B3174E68"
                       FontSize="12"
                       Text="管理角色外观、文件互动和桌面行为。" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource SettingCardStyle}">
            <StackPanel>
                <TextBlock Margin="0,0,0,5"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="桌面行为" />
                <CheckBox x:Name="StartWithWindowsCheckBox"
                          AutomationProperties.Name="登录 Windows 后自动启动洛天依桌宠"
                          Content="登录 Windows 后自动启动桌宠" />
                <CheckBox x:Name="AlwaysOnTopCheckBox"
                          AutomationProperties.Name="桌宠始终置顶"
                          Content="桌宠始终置顶" />
                <CheckBox x:Name="DesktopFileTreatsCheckBox"
                          AutomationProperties.Name="桌面文件消失后生成小笼包"
                          Content="桌面文件移入回收站后，生成可拖动的小笼包并让天依追过去" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="#A8174E68"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Text="开机启动与始终置顶也可以直接从 Windows 右下角的洛天依托盘图标切换。文件功能只观察桌面项目名称与图标位置，不读取文件内容。" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SettingCardStyle}">
            <StackPanel>
                <TextBlock FontSize="15"
                           FontWeight="SemiBold"
                           Text="完整全身互动外观" />
                <TextBlock Margin="0,4,0,8"
                           Foreground="#A8174E68"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Text="双击桌宠进入完整全身互动模式时使用。三套外观都保留身体区域互动。" />
                <UniformGrid Columns="3">
                    <RadioButton x:Name="FullBodyLongHairRadio"
                                 GroupName="FullBodyStyle"
                                 Style="{StaticResource PreviewChoiceStyle}"
                                 AutomationProperties.Name="使用华裳长发版完整全身外观">
                        <Border Padding="8" Background="#0D66CCFF" CornerRadius="10">
                            <StackPanel>
                                <Image x:Name="FullBodyLongHairPreview" Height="145" Stretch="Uniform" />
                                <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Text="华裳长发版" />
                                <TextBlock HorizontalAlignment="Center" FontSize="10" Foreground="#A8174E68" Text="精细长发 · 华丽衣装" />
                            </StackPanel>
                        </Border>
                    </RadioButton>
                    <RadioButton x:Name="FullBodyCrystalDressRadio"
                                 GroupName="FullBodyStyle"
                                 Style="{StaticResource PreviewChoiceStyle}"
                                 AutomationProperties.Name="使用晶蓝礼服版完整全身外观">
                        <Border Padding="8" Background="#0D66CCFF" CornerRadius="10">
                            <StackPanel>
                                <Image x:Name="FullBodyCrystalDressPreview" Height="145" Stretch="Uniform" />
                                <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Text="晶蓝礼服版" />
                                <TextBlock HorizontalAlignment="Center" FontSize="10" Foreground="#A8174E68" Text="新 Q 版 · 白蓝礼服" />
                            </StackPanel>
                        </Border>
                    </RadioButton>
                    <RadioButton x:Name="FullBodyClassicCatEarsRadio"
                                 GroupName="FullBodyStyle"
                                 Style="{StaticResource PreviewChoiceStyle}"
                                 AutomationProperties.Name="使用经典猫耳版完整全身外观">
                        <Border Padding="8" Background="#0D66CCFF" CornerRadius="10">
                            <StackPanel>
                                <Image x:Name="FullBodyClassicCatEarsPreview" Height="145" Stretch="Uniform" />
                                <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Text="经典猫耳版" />
                                <TextBlock HorizontalAlignment="Center" FontSize="10" Foreground="#A8174E68" Text="经典 Q 版 · 简洁造型" />
                            </StackPanel>
                        </Border>
                    </RadioButton>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource SettingCardStyle}">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="吃包子动画" />
                <TextBlock Margin="0,4,0,8"
                           Foreground="#A8174E68"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Text="桌面文件变成小笼包后，选择天依追逐和吃掉包子时使用的画风。" />
                <UniformGrid Columns="2">
                    <RadioButton x:Name="BunEatingOriginalRadio"
                                 GroupName="BunEatingStyle"
                                 Style="{StaticResource PreviewChoiceStyle}"
                                 AutomationProperties.Name="使用经典吃包子动画">
                        <Border Padding="8" Background="#0D66CCFF" CornerRadius="10">
                            <StackPanel>
                                <Image x:Name="BunEatingOriginalPreview" Height="125" Stretch="Uniform" />
                                <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Text="元气追包版" />
                                <TextBlock HorizontalAlignment="Center" FontSize="10" Foreground="#A8174E68" Text="现用手工抠像版本" />
                            </StackPanel>
                        </Border>
                    </RadioButton>
                    <RadioButton x:Name="BunEatingNewRadio"
                                 GroupName="BunEatingStyle"
                                 Style="{StaticResource PreviewChoiceStyle}"
                                 AutomationProperties.Name="使用新版吃包子动画">
                        <Border Padding="8" Background="#0D66CCFF" CornerRadius="10">
                            <StackPanel>
                                <Image x:Name="BunEatingNewPreview" Height="125" Stretch="Uniform" />
                                <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Text="甜笑寻包版" />
                                <TextBlock HorizontalAlignment="Center" FontSize="10" Foreground="#A8174E68" Text="新增 AI 动画版本" />
                            </StackPanel>
                        </Border>
                    </RadioButton>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource SettingCardStyle}">
            <StackPanel>
                <TextBlock FontSize="15"
                           FontWeight="SemiBold"
                           Text="QQ / 微信消息提醒" />
                <CheckBox x:Name="MessageReminderCheckBox"
                          AutomationProperties.Name="启用 QQ 和微信消息来源提醒"
                          Content="收到系统通知且来源应用不在前台时提醒" />
                <TextBlock Margin="0,4,0,10"
                           Foreground="#A8174E68"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Text="桌宠会读取应用图标和通知标题，用于显示联系人昵称或群名；不读取、显示、保存或记录消息正文。标题结构不明确时只显示应用来源。" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NotificationAccessStatusText"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               Foreground="#C2174E68"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="正在检查 Windows 通知访问状态……" />
                    <Button x:Name="NotificationAccessButton"
                            Grid.Column="1"
                            AutomationProperties.Name="授权 Windows 通知访问"
                            MinWidth="94"
                            Height="34"
                            Padding="12,0"
                            Click="OnRequestNotificationAccessClick"
                            Content="授权访问" />
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="5" Margin="2,2,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1"
                    AutomationProperties.Name="保存桌宠设置"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnSaveClick"
                    Content="保存并关闭" />
        </Grid>
    </Grid>
    </ScrollViewer>
</Window>
