<Window x:Class="LuoTianyiPet.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="洛天依桌宠设置"
        Width="660"
        MaxHeight="760"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FFF3F8FC"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Loaded="OnLoaded">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FF32B9F2" />
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#FF0878A9" />
        <SolidColorBrush x:Key="TextBrush" Color="#FF143F55" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A8143F55" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="SettingCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="20,18" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="#FCFFFFFF" />
            <Setter Property="BorderBrush" Value="#337ECDEB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" Color="#FF5B9FBA" Direction="270"
                                      Opacity="0.10" ShadowDepth="3" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionIconStyle" TargetType="Border">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Background" Value="#2032B9F2" />
            <Setter Property="CornerRadius" Value="11" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SectionDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="RowSurface" MinHeight="38" Padding="10,6"
                                Background="Transparent" CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Margin="0,0,16,0" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                                <Grid Grid.Column="1" Width="42" Height="24" VerticalAlignment="Center">
                                    <Border x:Name="ToggleTrack" Background="#FFD8E3E9"
                                            BorderBrush="#80A6B9C3" BorderThickness="1"
                                            CornerRadius="12" />
                                    <Ellipse x:Name="ToggleThumb" Width="18" Height="18" Margin="3"
                                             HorizontalAlignment="Left" Fill="White">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="4" Color="#FF234C60"
                                                              Opacity="0.24" ShadowDepth="1" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowSurface" Property="Background" Value="#1232B9F2" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RowSurface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="94" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}" />
            <Setter Property="Background" Value="#1832B9F2" />
            <Setter Property="BorderBrush" Value="#5532B9F2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}" />
        <Style x:Key="PrimaryButtonStyle" TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#FF1AA6E1" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#FFF7FBFD" />
            <Setter Property="BorderBrush" Value="#667ECDEB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,20,24,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Margin="0,0,0,16" Padding="18,15"
                    Background="#FF0D759F" CornerRadius="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" Margin="0,0,14,0"
                            Background="#24FFFFFF" CornerRadius="14">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets" FontSize="22"
                                   Foreground="White" Text="&#xE713;" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="21" FontWeight="SemiBold" Foreground="White"
                                   Text="洛天依桌宠设置" />
                        <TextBlock Margin="0,3,0,0" FontSize="11.5" Foreground="#DFF4FBFF"
                                   Text="把常用开关留在这里，音量直接在桌宠控制岛调节。" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource SettingCardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SectionIconStyle}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{StaticResource PrimaryDarkBrush}" Text="&#xE80F;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="桌面行为" />
                            <TextBlock Style="{StaticResource SectionDescriptionStyle}"
                                       Text="启动方式、窗口层级与日常互动。" />
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="StartWithWindowsCheckBox"
                              AutomationProperties.Name="登录 Windows 后自动启动洛天依桌宠"
                              Content="登录 Windows 后自动启动桌宠" />
                    <CheckBox x:Name="AlwaysOnTopCheckBox"
                              AutomationProperties.Name="桌宠始终置顶" Content="桌宠始终置顶" />
                    <CheckBox x:Name="FullBodyStyleCyclingCheckBox"
                              AutomationProperties.Name="允许双击循环三种桌宠外观"
                              Content="双击桌宠时循环切换三种外观" />
                    <CheckBox x:Name="DesktopFileTreatsCheckBox"
                              AutomationProperties.Name="启用吃包子功能"
                              Content="启用吃包子功能（桌面删除追包与拖到桌宠回收）" />
                    <Border Margin="8,8,8,0" Padding="11,9" Background="#0F32B9F2"
                            CornerRadius="10">
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="10.5"
                                   TextWrapping="Wrap"
                                   Text="关闭外观循环后会固定当前外观。吃包子功能只观察桌面项目名称与图标位置，不读取文件内容。" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource SettingCardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SectionIconStyle}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{StaticResource PrimaryDarkBrush}" Text="&#xE8D6;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="音乐播放动画" />
                            <TextBlock Style="{StaticResource SectionDescriptionStyle}"
                                       Text="选择网易云播放音乐时持续循环的动作。" />
                        </StackPanel>
                    </Grid>
                    <Border Background="#FFF7FBFD"
                            BorderBrush="#667ECDEB"
                            BorderThickness="1"
                            CornerRadius="11"
                            ClipToBounds="True">
                        <ComboBox x:Name="MusicAnimationSelectionComboBox"
                                  AutomationProperties.Name="音乐播放动画选择"
                                  BorderThickness="0" />
                    </Border>
                    <TextBlock Margin="2,9,2,0" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10.5" TextWrapping="Wrap"
                               Text="随机模式会在开始播放、继续播放或切歌时重新抽取；以后新增循环动作也会继续加入。" />
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource SettingCardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SectionIconStyle}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{StaticResource PrimaryDarkBrush}" Text="&#xE8BD;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="QQ / 微信消息提醒" />
                            <TextBlock Style="{StaticResource SectionDescriptionStyle}"
                                       Text="只显示应用来源和可用的联系人或群名。" />
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="MessageReminderCheckBox"
                              AutomationProperties.Name="启用 QQ 和微信消息来源提醒"
                              Content="来源应用不在前台时显示提醒" />
                    <Border Margin="8,8,8,11" Padding="12,10" Background="#0F32B9F2"
                            CornerRadius="10">
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="10.5"
                                   TextWrapping="Wrap"
                                   Text="桌宠不会读取、显示、保存或记录消息正文；标题结构不明确时只显示应用来源。" />
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="NotificationAccessStatusText" Margin="8,0,14,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10.5" TextWrapping="Wrap"
                                   Text="正在检查 Windows 通知访问状态……" />
                        <Button x:Name="NotificationAccessButton" Grid.Column="1"
                                AutomationProperties.Name="授权 Windows 通知访问"
                                Click="OnRequestNotificationAccessClick" Content="授权访问" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="4" Margin="2,4,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Foreground="#7A143F55" FontSize="10.5"
                           Text="更改会在保存后立即生效" />
                <Button Grid.Column="1" AutomationProperties.Name="保存桌宠设置"
                        Style="{StaticResource PrimaryButtonStyle}" Click="OnSaveClick"
                        Content="保存并关闭" />
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
