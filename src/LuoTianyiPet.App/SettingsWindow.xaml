<Window x:Class="LuoTianyiPet.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="洛天依桌宠设置" Icon="/assets/app/luotianyi-pet.ico"
        Width="570" Height="620" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F7FBFD"
        FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True"
        SnapsToDevicePixels="True" Loaded="OnLoaded">
    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#32B9F2" />
        <SolidColorBrush x:Key="PrimaryDark" Color="#0878A9" />
        <SolidColorBrush x:Key="Text" Color="#173F54" />
        <SolidColorBrush x:Key="Muted" Color="#6B8390" />
        <SolidColorBrush x:Key="Line" Color="#D8E8EF" />

        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}" /></Style>
        <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style x:Key="PageDescription" TargetType="TextBlock"><Setter Property="Margin" Value="0,3,0,15" /><Setter Property="Foreground" Value="{StaticResource Muted}" /><Setter Property="FontSize" Value="11" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock"><Setter Property="Margin" Value="4,4,4,3" /><Setter Property="FontSize" Value="13.5" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style x:Key="OptionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style x:Key="OptionDescription" TargetType="TextBlock"><Setter Property="Margin" Value="0,2,0,0" /><Setter Property="Foreground" Value="{StaticResource Muted}" /><Setter Property="FontSize" Value="10.5" /><Setter Property="TextWrapping" Value="Wrap" /></Style>

        <Style x:Key="GroupCard" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,12" /><Setter Property="Padding" Value="5" />
            <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="NavigationItem" TargetType="RadioButton">
            <Setter Property="Height" Value="44" /><Setter Property="Margin" Value="8,1" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9">
                        <Grid>
                            <Border x:Name="Bar" Width="3" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource Primary}" CornerRadius="0,2,2,0" Opacity="0" />
                            <ContentPresenter Margin="14,0,8,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1032B9F2" /></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{StaticResource PrimaryDark}" /><Setter TargetName="Surface" Property="Background" Value="#1832B9F2" /><Setter TargetName="Bar" Property="Opacity" Value="1" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Primary}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="MinHeight" Value="54" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Border x:Name="Row" Padding="10,7" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ContentPresenter Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Grid Grid.Column="1" Width="42" Height="23" VerticalAlignment="Center">
                            <Border x:Name="Track" Background="#D7E4EA" BorderBrush="#B8CBD4" BorderThickness="1" CornerRadius="12" />
                            <Ellipse x:Name="Thumb" Width="17" Height="17" Margin="3" HorizontalAlignment="Left" Fill="White" />
                        </Grid>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#0E32B9F2" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{StaticResource Primary}" /><Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Primary}" /><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Primary}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="SelectionCard" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="82" /><Setter Property="Margin" Value="0,0,8,8" /><Setter Property="Padding" Value="11,9" />
            <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="{StaticResource Line}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Card" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                    <Grid><ContentPresenter Margin="0,0,18,0" VerticalAlignment="Center" />
                        <Border x:Name="Badge" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource Primary}" CornerRadius="9" Opacity="0">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE73E;" />
                        </Border>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#F6FBFE" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="Background" Value="#1632B9F2" /><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Primary}" /><Setter TargetName="Badge" Property="Opacity" Value="1" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource PrimaryDark}" /><Setter TargetName="Card" Property="BorderThickness" Value="2" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="MusicPreviewCard" TargetType="RadioButton">
            <Setter Property="Height" Value="112" /><Setter Property="Margin" Value="0,0,6,0" /><Setter Property="Padding" Value="5" />
            <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="{StaticResource Line}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Card" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                    <Grid>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border x:Name="Badge" Width="18" Height="18" Margin="0,2,2,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource Primary}" CornerRadius="9" Opacity="0">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE73E;" />
                        </Border>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#F2FAFE" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="Background" Value="#1632B9F2" /><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Primary}" /><Setter TargetName="Badge" Property="Opacity" Value="1" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource PrimaryDark}" /><Setter TargetName="Card" Property="BorderThickness" Value="2" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="MusicNoneCard" TargetType="RadioButton">
            <Setter Property="Height" Value="40" /><Setter Property="Margin" Value="0,7,6,0" /><Setter Property="Padding" Value="9,4" />
            <Setter Property="Background" Value="#F7FBFD" /><Setter Property="BorderBrush" Value="{StaticResource Line}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Card" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                    <Grid><ContentPresenter VerticalAlignment="Center" />
                        <Border x:Name="Badge" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource Primary}" CornerRadius="9" Opacity="0">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE73E;" />
                        </Border>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#F2FAFE" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="Background" Value="#1632B9F2" /><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Primary}" /><Setter TargetName="Badge" Property="Opacity" Value="1" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource PrimaryDark}" /><Setter TargetName="Card" Property="BorderThickness" Value="2" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="88" /><Setter Property="Height" Value="36" /><Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryDark}" /><Setter Property="Background" Value="#1232B9F2" />
            <Setter Property="BorderBrush" Value="#6632B9F2" /><Setter Property="BorderThickness" Value="1" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2032B9F2" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PrimaryDark}" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}" />
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}"><Setter Property="MinWidth" Value="118" /><Setter Property="Height" Value="38" /><Setter Property="Foreground" Value="White" /><Setter Property="Background" Value="{StaticResource Primary}" /><Setter Property="BorderBrush" Value="#1AA6E1" /></Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="7" /><Setter Property="Background" Value="Transparent" /><Setter Property="Focusable" Value="False" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Grid Width="7" Margin="0,3" Background="Transparent">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb MinHeight="30"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#8EB8CBD4" CornerRadius="3" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="58" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="154" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

        <Border Background="#F1F8FC" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="83" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Margin="14,14,8,8" Orientation="Horizontal">
                    <Border Width="42" Height="42" Margin="0,0,9,0" Background="#1832B9F2" CornerRadius="12"><Image Margin="3" Source="/assets/app/luotianyi-pet.png" Stretch="Uniform" /></Border>
                    <StackPanel VerticalAlignment="Center"><TextBlock FontSize="15" FontWeight="SemiBold" Text="洛天依桌宠" /><TextBlock Margin="0,2,0,0" Foreground="{StaticResource Muted}" FontSize="10.5" Text="设置" /></StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="GeneralNavigationRadioButton" GroupName="SettingsNavigation" Style="{StaticResource NavigationItem}" AutomationProperties.Name="常规设置" Tag="General" Checked="OnNavigationChecked"><StackPanel Orientation="Horizontal"><TextBlock Width="26" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontFamily="Segoe MDL2 Assets" FontSize="17" Text="&#xE713;" /><TextBlock FontSize="13" FontWeight="SemiBold" Text="常规" /></StackPanel></RadioButton>
                    <RadioButton x:Name="MusicNavigationRadioButton" GroupName="SettingsNavigation" Style="{StaticResource NavigationItem}" AutomationProperties.Name="音乐设置" Tag="Music" Checked="OnNavigationChecked"><StackPanel Orientation="Horizontal"><TextBlock Width="26" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontFamily="Segoe MDL2 Assets" FontSize="17" Text="&#xE8D6;" /><TextBlock FontSize="13" FontWeight="SemiBold" Text="音乐" /></StackPanel></RadioButton>
                    <RadioButton x:Name="NotificationNavigationRadioButton" GroupName="SettingsNavigation" Style="{StaticResource NavigationItem}" AutomationProperties.Name="通知设置" Tag="Notification" Checked="OnNavigationChecked"><StackPanel Orientation="Horizontal"><TextBlock Width="26" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontFamily="Segoe MDL2 Assets" FontSize="17" Text="&#xE7F4;" /><TextBlock FontSize="13" FontWeight="SemiBold" Text="通知" /></StackPanel></RadioButton>
                    <RadioButton x:Name="AboutNavigationRadioButton" GroupName="SettingsNavigation" Style="{StaticResource NavigationItem}" AutomationProperties.Name="关于洛天依桌宠" Tag="About" Checked="OnNavigationChecked"><StackPanel Orientation="Horizontal"><TextBlock Width="26" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontFamily="Segoe MDL2 Assets" FontSize="17" Text="&#xE946;" /><TextBlock FontSize="13" FontWeight="SemiBold" Text="关于" /></StackPanel></RadioButton>
                </StackPanel>
                <Grid Grid.Row="2" Margin="10,8,8,8" IsHitTestVisible="False">
                    <TextBlock x:Name="PageSpeechText" Margin="7,0,2,116" VerticalAlignment="Bottom" Foreground="#4E9DBD" FontSize="13" FontWeight="SemiBold" LineHeight="21" Text="今天也，&#x0a;一起加油吧～" TextWrapping="Wrap" />
                    <Image Width="132" Height="116" HorizontalAlignment="Right" VerticalAlignment="Bottom" Source="/assets/ui/settings-encouragement.png" Stretch="Uniform" Opacity="0.95" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="White">
            <ScrollViewer x:Name="GeneralPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,18,14,18">
                    <TextBlock Style="{StaticResource PageTitle}" Text="常规" /><TextBlock Style="{StaticResource PageDescription}" Text="管理桌宠的启动、显示和日常互动。" />
                    <TextBlock Style="{StaticResource GroupTitle}" Text="应用行为" />
                    <Border Style="{StaticResource GroupCard}"><StackPanel>
                        <CheckBox x:Name="StartWithWindowsCheckBox" AutomationProperties.Name="登录 Windows 后自动启动洛天依桌宠" Checked="OnSettingChanged" Unchecked="OnSettingChanged"><StackPanel><TextBlock Style="{StaticResource OptionTitle}" Text="开机自动启动" /><TextBlock Style="{StaticResource OptionDescription}" Text="登录 Windows 后自动运行桌宠" /></StackPanel></CheckBox>
                        <Separator Margin="10,0" Background="#80D8E8EF" />
                        <CheckBox x:Name="AlwaysOnTopCheckBox" AutomationProperties.Name="桌宠始终置顶" Checked="OnSettingChanged" Unchecked="OnSettingChanged"><StackPanel><TextBlock Style="{StaticResource OptionTitle}" Text="始终置顶" /><TextBlock Style="{StaticResource OptionDescription}" Text="保持桌宠显示在其他普通窗口上方" /></StackPanel></CheckBox>
                    </StackPanel></Border>
                    <TextBlock Style="{StaticResource GroupTitle}" Text="桌宠互动" />
                    <Border Style="{StaticResource GroupCard}"><StackPanel>
                        <CheckBox x:Name="FullBodyStyleCyclingCheckBox" AutomationProperties.Name="允许双击循环三种桌宠外观" Checked="OnSettingChanged" Unchecked="OnSettingChanged"><StackPanel><TextBlock Style="{StaticResource OptionTitle}" Text="双击切换外观" /><TextBlock Style="{StaticResource OptionDescription}" Text="在三种外观间循环；关闭后固定当前外观" /></StackPanel></CheckBox>
                        <Separator Margin="10,0" Background="#80D8E8EF" />
                        <CheckBox x:Name="DesktopFileTreatsCheckBox" AutomationProperties.Name="启用吃包子功能" Checked="OnSettingChanged" Unchecked="OnSettingChanged"><StackPanel><TextBlock Style="{StaticResource OptionTitle}" Text="吃包子功能" /><TextBlock Style="{StaticResource OptionDescription}" Text="追逐桌面删除后出现的包子，或把拖入文件移至回收站" /></StackPanel></CheckBox>
                    </StackPanel></Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="MusicPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,18,6,18">
                    <TextBlock Style="{StaticResource PageTitle}" Text="音乐" /><TextBlock Margin="0,3,8,15" Style="{StaticResource PageDescription}" Text="选择网易云音乐播放时，桌宠使用哪种听歌动作。" />
                    <TextBlock Style="{StaticResource GroupTitle}" Text="播放动画" />
                    <TextBlock Margin="4,1,12,9" Style="{StaticResource OptionDescription}" Text="自动会按歌手分配；也可以直接固定一种画面。" />
                    <Grid x:Name="MusicAnimationSelectionPanel" Margin="0,0,8,8">
                        <Grid.RowDefinitions><RowDefinition Height="112" /><RowDefinition Height="47" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" GroupName="MusicAnimationSelection" Style="{StaticResource MusicPreviewCard}" AutomationProperties.Name="自动识别歌手" AutomationProperties.HelpText="普通歌曲使用享受音乐，洛天依歌曲随机使用彩蛋" Tag="automatic-by-artist" ToolTip="普通歌享受音乐；天依歌曲随机彩蛋" Checked="OnSettingChanged">
                            <StackPanel HorizontalAlignment="Center"><Border Width="76" Height="72" Background="#EAF8FE" CornerRadius="8"><Image Margin="2" Source="/assets/ui/music-preview-auto.png" Stretch="Uniform" /></Border><TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Text="自动" /></StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" GroupName="MusicAnimationSelection" Style="{StaticResource MusicPreviewCard}" AutomationProperties.Name="固定享受音乐" AutomationProperties.HelpText="固定使用普通歌曲默认的安静听歌动作" Tag="resonance-enjoy-music" ToolTip="普通歌曲默认的安静听歌动作" Checked="OnSettingChanged">
                            <StackPanel HorizontalAlignment="Center"><Border Width="76" Height="72" Background="#EAF8FE" CornerRadius="8"><Image Margin="2" Source="/assets/ui/music-preview-enjoy.png" Stretch="Uniform" /></Border><TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Text="享受音乐" /></StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="2" GroupName="MusicAnimationSelection" Style="{StaticResource MusicPreviewCard}" AutomationProperties.Name="固定音乐摇摆" AutomationProperties.HelpText="固定使用洛天依歌曲的音乐摇摆彩蛋" Tag="ninth-anniversary-music-sway" ToolTip="洛天依歌曲使用的循环彩蛋" Checked="OnSettingChanged">
                            <StackPanel HorizontalAlignment="Center"><Border Width="76" Height="72" Background="#EAF8FE" CornerRadius="8"><Image Margin="2" Source="/assets/ui/music-preview-sway.png" Stretch="Uniform" /></Border><TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Text="音乐摇摆" /></StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="3" GroupName="MusicAnimationSelection" Style="{StaticResource MusicPreviewCard}" AutomationProperties.Name="固定一键唱歌" AutomationProperties.HelpText="固定使用洛天依歌曲的一键唱歌彩蛋" Tag="newyear-one-click-singing" ToolTip="洛天依歌曲使用的循环唱歌彩蛋" Checked="OnSettingChanged">
                            <StackPanel HorizontalAlignment="Center"><Border Width="76" Height="72" Background="#EAF8FE" CornerRadius="8"><Image Margin="2" Source="/assets/ui/music-preview-sing.png" Stretch="Uniform" /></Border><TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Text="一键唱歌" /></StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Row="1" Grid.ColumnSpan="4" GroupName="MusicAnimationSelection" Style="{StaticResource MusicNoneCard}" AutomationProperties.Name="不使用任何听歌动画" Tag="none" Checked="OnSettingChanged">
                            <StackPanel Orientation="Horizontal"><Border Width="26" Height="26" Margin="0,0,8,0" Background="#DCEBF1" CornerRadius="7"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="17" Text="—" /></Border><StackPanel VerticalAlignment="Center"><TextBlock FontSize="11.5" FontWeight="SemiBold" Text="不使用动画" /><TextBlock Foreground="{StaticResource Muted}" FontSize="9.5" Text="播放音乐时保持当前桌宠外观" /></StackPanel></StackPanel>
                        </RadioButton>
                    </Grid>
                    <TextBlock Margin="4,7,4,3" Style="{StaticResource GroupTitle}" Text="洛天依歌曲彩蛋" />
                    <Border Style="{StaticResource GroupCard}" Margin="0,0,8,12"><CheckBox x:Name="LuoTianyiSingingEasterEggCheckBox" AutomationProperties.Name="允许洛天依歌曲触发一键唱歌彩蛋" Checked="OnSettingChanged" Unchecked="OnSettingChanged"><StackPanel><TextBlock Style="{StaticResource OptionTitle}" Text="允许“一键唱歌”" /><TextBlock Style="{StaticResource OptionDescription}" Text="关闭后，自动模式和固定一键唱歌均改用音乐摇摆" /></StackPanel></CheckBox></Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="NotificationPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,18,14,18">
                    <TextBlock Style="{StaticResource PageTitle}" Text="通知" /><TextBlock Style="{StaticResource PageDescription}" Text="管理 QQ / 微信来源提醒和 Windows 通知权限。" />
                    <TextBlock Style="{StaticResource GroupTitle}" Text="消息提醒" />
                    <Border Style="{StaticResource GroupCard}"><CheckBox x:Name="MessageReminderCheckBox" AutomationProperties.Name="启用 QQ 和微信消息来源提醒" Checked="OnSettingChanged" Unchecked="OnSettingChanged"><StackPanel><TextBlock Style="{StaticResource OptionTitle}" Text="QQ / 微信消息提醒" /><TextBlock Style="{StaticResource OptionDescription}" Text="来源应用不在前台时，显示应用和联系人或群名" /></StackPanel></CheckBox></Border>
                    <TextBlock Style="{StaticResource GroupTitle}" Text="Windows 通知权限" />
                    <Border Style="{StaticResource GroupCard}" Padding="14,12"><StackPanel>
                        <Border Padding="10,8" Background="#1232B9F2" CornerRadius="8"><TextBlock x:Name="NotificationAccessStatusText" Foreground="{StaticResource PrimaryDark}" FontSize="10.5" TextWrapping="Wrap" Text="正在检查 Windows 通知访问状态……" /></Border>
                        <Button x:Name="NotificationAccessButton" Margin="0,10,0,0" HorizontalAlignment="Left" AutomationProperties.Name="授权 Windows 通知访问" Click="OnRequestNotificationAccessClick" Content="授权访问" />
                    </StackPanel></Border>
                    <Border Padding="13,11" Background="#F1F8FC" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock FontSize="12" FontWeight="SemiBold" Text="隐私说明" /><TextBlock Margin="0,4,0,0" Style="{StaticResource OptionDescription}" Text="桌宠不会读取、显示、保存或记录消息正文；标题结构不明确时只显示应用来源。" /></StackPanel></Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="AboutPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,18,14,18">
                    <TextBlock Style="{StaticResource PageTitle}" Text="关于" /><TextBlock Style="{StaticResource PageDescription}" Text="关于这只留在 Windows 桌面上的洛天依桌宠。" />
                    <Border Style="{StaticResource GroupCard}" Padding="15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="62" Height="62" Background="#1632B9F2" CornerRadius="17"><Image Margin="4" Source="/assets/app/luotianyi-pet.png" Stretch="Uniform" /></Border>
                        <StackPanel Grid.Column="1" Margin="5,2,0,0"><TextBlock FontSize="17" FontWeight="SemiBold" Text="洛天依桌宠" /><TextBlock x:Name="VersionTextBlock" Margin="0,4,0,0" Foreground="{StaticResource Muted}" FontSize="10.5" Text="版本 0.1.0" /><TextBlock Margin="0,3,0,0" Foreground="{StaticResource Muted}" FontSize="10.5" Text="Windows 10 / 11 · 普通用户权限" /></StackPanel>
                    </Grid></Border>
                    <TextBlock Style="{StaticResource GroupTitle}" Text="本地运行" /><Border Style="{StaticResource GroupCard}" Padding="14,12"><TextBlock Style="{StaticResource OptionDescription}" Text="角色动画、设置和交互数据保存在本机；不上传播放历史、桌面项目或聊天内容。" /></Border>
                    <TextBlock Style="{StaticResource GroupTitle}" Text="文件安全" /><Border Style="{StaticResource GroupCard}" Padding="14,12"><TextBlock Style="{StaticResource OptionDescription}" Text="拖入桌宠的文件只会请求移入 Windows 回收站。操作失败时保留原文件，绝不回退为永久删除。" /></Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="18,9" Background="#FCFFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="SaveStatusText" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10.5" Text="更改会在保存后立即生效" />
                <Button Grid.Column="1" AutomationProperties.Name="保存桌宠设置" Style="{StaticResource PrimaryButton}" Click="OnSaveClick" Content="保存并关闭" />
            </Grid>
        </Border>
    </Grid>
</Window>
