<Window x:Class="LuoTianyiPet.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="洛天依桌宠设置"
        Width="430"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5FBFF"
        Closed="OnClosed"
        Loaded="OnLoaded">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF174E68" />
        </Style>
        <Style x:Key="SettingCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#5566CCFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FF174E68" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,7,0,7" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF39BDF5" />
            <Setter Property="BorderBrush" Value="#FF169DD8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,2,16">
            <TextBlock FontSize="23" FontWeight="Bold" Text="声音与反馈" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="#B3174E68"
                       FontSize="12"
                       Text="调整 Windows 系统音量，以及桌宠对音量变化的响应方式。" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource SettingCardStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="系统音量" />
                    <Border Grid.Column="1"
                            Padding="9,3"
                            Background="#2466CCFF"
                            CornerRadius="9">
                        <TextBlock x:Name="VolumeValueText"
                                   FontWeight="Bold"
                                   Foreground="#FF0875A8"
                                   Text="--%" />
                    </Border>
                </Grid>
                <Slider x:Name="VolumeSlider"
                        AutomationProperties.Name="系统音量"
                        Margin="0,14,0,5"
                        Minimum="0"
                        Maximum="100"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        IsMoveToPointEnabled="True"
                        ValueChanged="OnVolumeSliderValueChanged" />
                <TextBlock x:Name="VolumeStatusText"
                           MinHeight="18"
                           Foreground="#B3174E68"
                           FontSize="11"
                           Text="正在读取默认多媒体输出设备……" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SettingCardStyle}">
            <StackPanel>
                <TextBlock Margin="0,0,0,5"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="桌宠反馈" />
                <CheckBox x:Name="MouseWheelControlCheckBox"
                          AutomationProperties.Name="启用桌宠滚轮音量控制"
                          Content="鼠标位于桌宠上时，使用滚轮调整系统音量" />
                <CheckBox x:Name="ExternalFeedbackCheckBox"
                          AutomationProperties.Name="启用外部系统音量变化反馈"
                          Content="系统音量从其它位置改变时，播放动画并显示气泡" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="13" Text="滚轮每格调整" />
                        <TextBlock Margin="0,3,8,0"
                                   Foreground="#A8174E68"
                                   FontSize="11"
                                   Text="数值越大，音量变化越快。" />
                    </StackPanel>
                    <ComboBox x:Name="WheelStepComboBox"
                              AutomationProperties.Name="滚轮每格音量步长"
                              Grid.Column="1"
                              Height="32"
                              VerticalContentAlignment="Center">
                        <ComboBoxItem Tag="1">1%</ComboBoxItem>
                        <ComboBoxItem Tag="2">2%</ComboBoxItem>
                        <ComboBoxItem Tag="3">3%</ComboBoxItem>
                        <ComboBoxItem Tag="5">5%</ComboBoxItem>
                        <ComboBoxItem Tag="10">10%</ComboBoxItem>
                    </ComboBox>
                </Grid>
                <Border Margin="0,14,0,0"
                        Padding="10,8"
                        Background="#1266CCFF"
                        CornerRadius="8">
                    <TextBlock Foreground="#C2174E68"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="安全提示：原神等受保护游戏位于前台，或无法确认前台程序时，桌宠不会写入系统音量。" />
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource SettingCardStyle}">
            <StackPanel>
                <TextBlock FontSize="15"
                           FontWeight="SemiBold"
                           Text="QQ / 微信消息提醒" />
                <CheckBox x:Name="MessageReminderCheckBox"
                          AutomationProperties.Name="启用 QQ 和微信消息来源提醒"
                          Content="收到系统通知且来源应用不在前台时提醒" />
                <TextBlock Margin="0,4,0,10"
                           Foreground="#A8174E68"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Text="桌宠只识别通知的应用来源和时间，不读取发送者、群名或消息正文。" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NotificationAccessStatusText"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               Foreground="#C2174E68"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="正在检查 Windows 通知访问状态……" />
                    <Button x:Name="NotificationAccessButton"
                            Grid.Column="1"
                            AutomationProperties.Name="授权 Windows 通知访问"
                            MinWidth="94"
                            Height="34"
                            Padding="12,0"
                            Click="OnRequestNotificationAccessClick"
                            Content="授权访问" />
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4" Margin="2,2,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1"
                    AutomationProperties.Name="恢复反馈默认值"
                    Margin="0,0,10,0"
                    Padding="14,8"
                    Click="OnRestoreDefaultsClick"
                    Content="恢复反馈默认值" />
            <Button Grid.Column="2"
                    AutomationProperties.Name="保存声音与反馈设置"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnSaveClick"
                    Content="保存并关闭" />
        </Grid>
    </Grid>
</Window>
