<Window x:Class="LuoTianyiPet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="洛天依桌宠"
        Width="196"
        Height="196"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        Loaded="OnLoaded"
        Closed="OnClosed"
        LostMouseCapture="OnLostMouseCapture"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseLeftButtonUp="OnMouseLeftButtonUp"
        MouseMove="OnMouseMove">
    <Grid x:Name="Root">
        <Grid x:Name="PetVisual"
              Margin="8"
              RenderTransformOrigin="0.5,1">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PetScaleTransform" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="PetShakeTransform" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Image x:Name="PetImage"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SizeChanged="OnPetImageSizeChanged"
                   SnapsToDevicePixels="True"
                   Stretch="Fill" />

            <Border x:Name="FallbackSurface"
                    Width="180"
                    Height="180"
                    Padding="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="#E833B9D0"
                    BorderBrush="#EEFFFFFF"
                    BorderThickness="3"
                    CornerRadius="90"
                    Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="34"
                               Text="♪" />
                    <TextBlock Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="动画素材暂时不可用" />
                </StackPanel>
            </Border>

            <Canvas x:Name="BodyHitDebugOverlay"
                    Panel.ZIndex="3"
                    Width="{Binding ActualWidth, ElementName=PetImage}"
                    Height="{Binding ActualHeight, ElementName=PetImage}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
        </Grid>

        <Ellipse x:Name="MusicTransitionFlash"
                 Panel.ZIndex="2"
                 Width="150"
                 Height="150"
                 Margin="8"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 IsHitTestVisible="False"
                 Opacity="0"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="#F8FFFFFF" />
                    <GradientStop Offset="0.42" Color="#D85FE7F2" />
                    <GradientStop Offset="0.76" Color="#704ACFDF" />
                    <GradientStop Offset="1" Color="#004ACFDF" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="MusicTransitionFlashScale" ScaleX="0.35" ScaleY="0.35" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <Border x:Name="FeedbackBubble"
                Panel.ZIndex="4"
                MaxWidth="240"
                Margin="6"
                Padding="9,6"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#EC07363B"
                BorderBrush="#E86BE7E9"
                BorderThickness="1"
                CornerRadius="10"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <TextBlock x:Name="FeedbackBubbleText"
                       Foreground="White"
                       FontSize="12"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </Border>

        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="FullBodyModeMenuItem"
                          Header="完整全身互动模式"
                          IsCheckable="True"
                          Click="OnToggleDisplayMode" />
                <MenuItem Header="动画与状态验证">
                    <MenuItem Header="模拟开始播放音乐" Click="OnPreviewMusicStart" />
                    <MenuItem Header="模拟停止音乐" Click="OnPreviewMusicStop" />
                    <MenuItem x:Name="BodyHitDebugMenuItem"
                              Header="显示身体区域调试层"
                              IsCheckable="True"
                              Click="OnToggleBodyHitDebug" />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="MediaCommandMenuItem" Header="网易云音乐">
                    <MenuItem x:Name="PreviousTrackMenuItem"
                              Click="OnPreviousTrackClick" />
                    <MenuItem x:Name="TogglePlayPauseMenuItem"
                              Click="OnTogglePlayPauseClick" />
                    <MenuItem x:Name="NextTrackMenuItem"
                              Click="OnNextTrackClick" />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="TopmostMenuItem"
                          Header="始终置顶"
                          IsCheckable="True"
                          Click="OnToggleTopmost" />
                <Separator />
                <MenuItem x:Name="ExitMenuItem" Header="退出桌宠" Click="OnExitClick" />
            </ContextMenu>
        </Grid.ContextMenu>
    </Grid>
</Window>
