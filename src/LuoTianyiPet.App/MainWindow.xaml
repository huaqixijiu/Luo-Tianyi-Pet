<Window x:Class="LuoTianyiPet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="洛天依桌宠"
        Width="196"
        Height="246"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        Loaded="OnLoaded"
        Closed="OnClosed"
        MouseLeftButtonDown="OnMouseLeftButtonDown">
    <Grid Margin="10">
        <Border x:Name="PetSurface"
                Cursor="Hand"
                CornerRadius="90,90,68,68"
                BorderBrush="#EFFFFFFF"
                BorderThickness="3">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#F86BE4EE" />
                    <GradientStop Offset="0.55" Color="#F33DB5D6" />
                    <GradientStop Offset="1" Color="#F427769E" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="16"
                                  Direction="270"
                                  Opacity="0.45"
                                  ShadowDepth="6"
                                  Color="#80204A5A" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="46" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#EFFFFFFF"
                           Text="M0 · 透明窗口验证" />

                <Grid Grid.Row="1">
                    <Ellipse Width="118"
                             Height="108"
                             Fill="#F6F7FBFF"
                             Stroke="#DDE8FFFF"
                             StrokeThickness="3" />
                    <Ellipse Width="24"
                             Height="34"
                             Margin="-46,12,0,0"
                             Fill="#FF4BA35A" />
                    <Ellipse Width="24"
                             Height="34"
                             Margin="46,12,0,0"
                             Fill="#FF4BA35A" />
                    <Path Margin="30,18,30,72"
                          Fill="#FFB8C6E9"
                          Stretch="Fill"
                          Data="M 0,35 C 8,0 78,0 100,28 L 92,15 L 82,34 L 68,10 L 56,32 L 39,8 L 28,31 L 14,14 Z" />
                    <Path Width="34"
                          Height="12"
                          Margin="0,76,0,0"
                          Stroke="#FF5C7187"
                          StrokeThickness="3"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M 0,0 Q 17,12 34,0" />
                </Grid>

                <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="洛天依桌宠" />
                    <TextBlock HorizontalAlignment="Center"
                               Margin="0,2,0,0"
                               FontSize="11"
                               Foreground="#E6FFFFFF"
                               Text="左键拖动 · 右键设置" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="TopmostMenuItem"
                          Header="始终置顶"
                          IsCheckable="True"
                          Click="OnToggleTopmost" />
                <Separator />
                <MenuItem Header="退出桌宠" Click="OnExitClick" />
            </ContextMenu>
        </Grid.ContextMenu>
    </Grid>
</Window>
