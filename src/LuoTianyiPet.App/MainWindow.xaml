<Window x:Class="LuoTianyiPet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="洛天依桌宠"
        Width="196"
        Height="306"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        Loaded="OnLoaded"
        Closed="OnClosed"
        AllowDrop="True"
        DragEnter="OnFileDragEnter"
        DragOver="OnFileDragOver"
        DragLeave="OnFileDragLeave"
        Drop="OnFileDrop"
        LostMouseCapture="OnLostMouseCapture"
        MouseEnter="OnRootMouseEnter"
        MouseLeave="OnRootMouseLeave"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseLeftButtonUp="OnMouseLeftButtonUp"
        MouseMove="OnMouseMove"
        PreviewMouseWheel="OnPreviewMouseWheel">
    <Window.Resources>
        <ControlTemplate x:Key="MediaButtonTemplate" TargetType="Button">
            <Grid x:Name="ButtonRoot"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform />
                </Grid.RenderTransform>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="18" />
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ButtonRoot" Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.08" ScaleY="1.08" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="ButtonRoot" Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="ButtonRoot" Property="Opacity" Value="0.42" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="MediaIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="#FF176A90" />
            <Setter Property="Template" Value="{StaticResource MediaButtonTemplate}" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4266CCFF" />
                    <Setter Property="BorderBrush" Value="#8066CCFF" />
                    <Setter Property="Foreground" Value="#FF075277" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#7066CCFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MediaPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#FF66CCFF" />
            <Setter Property="BorderBrush" Value="#D9FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template" Value="{StaticResource MediaButtonTemplate}" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF35B8F2" />
                    <Setter Property="BorderBrush" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF169DD8" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid x:Name="Root">
        <Grid x:Name="PetVisual"
              Margin="8,60,8,66"
              RenderTransformOrigin="0.5,1">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PetDirectionTransform" ScaleX="1" ScaleY="1" />
                    <ScaleTransform x:Name="PetScaleTransform" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="PetShakeTransform" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Image x:Name="PetImage"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SizeChanged="OnPetImageSizeChanged"
                   SnapsToDevicePixels="True"
                   Stretch="Fill" />

            <Border x:Name="FallbackSurface"
                    Width="180"
                    Height="180"
                    Padding="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="#E833B9D0"
                    BorderBrush="#EEFFFFFF"
                    BorderThickness="3"
                    CornerRadius="90"
                    Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="34"
                               Text="♪" />
                    <TextBlock Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="动画素材暂时不可用" />
                </StackPanel>
            </Border>

            <Canvas x:Name="BodyHitDebugOverlay"
                    Panel.ZIndex="3"
                    Width="{Binding ActualWidth, ElementName=PetImage}"
                    Height="{Binding ActualHeight, ElementName=PetImage}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
        </Grid>

        <Ellipse x:Name="MusicTransitionFlash"
                 Panel.ZIndex="2"
                 Width="150"
                 Height="150"
                 Margin="8,60,8,66"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 IsHitTestVisible="False"
                 Opacity="0"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="#F8FFFFFF" />
                    <GradientStop Offset="0.42" Color="#D85FE7F2" />
                    <GradientStop Offset="0.76" Color="#704ACFDF" />
                    <GradientStop Offset="1" Color="#004ACFDF" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="MusicTransitionFlashScale" ScaleX="0.35" ScaleY="0.35" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <Border x:Name="TrackInfoBubble"
                Panel.ZIndex="5"
                Height="44"
                Margin="5,6,5,0"
                Padding="12,5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Background="#F2083448"
                BorderBrush="#D966CCFF"
                BorderThickness="1"
                CornerRadius="14"
                IsHitTestVisible="False"
                Opacity="0"
                Visibility="Collapsed"
                AutomationProperties.Name="当前歌曲">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10"
                                  Color="#FF0A719D"
                                  Direction="270"
                                  Opacity="0.32"
                                  ShadowDepth="2" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="TrackInfoTranslate" Y="-6" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="TrackTitleText"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TrackArtistText"
                           Grid.Row="1"
                           Foreground="#D8C8F2FF"
                           FontSize="10"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Border x:Name="MessageNotificationBubble"
                Panel.ZIndex="8"
                Width="188"
                Height="58"
                Margin="4,4,4,0"
                Padding="8,6"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#F4F7FCFF"
                BorderBrush="#D966CCFF"
                BorderThickness="1"
                CornerRadius="15"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                AutomationProperties.Name="聊天消息提醒">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12"
                                  Color="#FF0A719D"
                                  Direction="270"
                                  Opacity="0.34"
                                  ShadowDepth="3" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Width="42"
                      Height="42"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center">
                    <Border x:Name="MessagePrimaryIconSurface"
                            Background="#FF66CCFF"
                            BorderBrush="White"
                            BorderThickness="1"
                            CornerRadius="21"
                            ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="MessageProviderGlyph"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Text="Q" />
                            <Image x:Name="MessagePrimaryIcon"
                                   Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <Border x:Name="MessageAppBadge"
                            Width="19"
                            Height="19"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="White"
                            BorderBrush="#FF66CCFF"
                            BorderThickness="1"
                            CornerRadius="9.5"
                            ClipToBounds="True"
                            Visibility="Collapsed">
                        <Image x:Name="MessageAppBadgeIcon"
                               Margin="2"
                               Stretch="Uniform" />
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1"
                            Margin="3,1,2,0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="MessageSourceText"
                               Foreground="#FF397B9A"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Text="QQ · 新消息" />
                    <TextBlock x:Name="MessageConversationText"
                               Margin="0,1,0,0"
                               Foreground="#FF18394A"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Text="有新消息"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="FeedbackBubble"
                Panel.ZIndex="4"
                MaxWidth="240"
                Margin="6,56,6,6"
                Padding="9,6"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#EC07363B"
                BorderBrush="#E86BE7E9"
                BorderThickness="1"
                CornerRadius="10"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <TextBlock x:Name="FeedbackBubbleText"
                       Foreground="White"
                       FontSize="12"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </Border>

        <Border x:Name="MediaControls"
                Panel.ZIndex="5"
                Width="136"
                Height="46"
                Margin="0,0,0,7"
                Padding="5,4"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                BorderBrush="#B366CCFF"
                BorderThickness="1"
                CornerRadius="23"
                IsHitTestVisible="False"
                Opacity="0"
                Visibility="Collapsed">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#F2F4FCFF" />
                    <GradientStop Offset="0.55" Color="#E8DFF6FF" />
                    <GradientStop Offset="1" Color="#EAD1F0FF" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="12"
                                  Color="#FF176A90"
                                  Direction="270"
                                  Opacity="0.30"
                                  ShadowDepth="3" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="MediaControlsTranslate" Y="8" />
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="42" />
                </Grid.ColumnDefinitions>

                <Button x:Name="PreviousTrackButton"
                        Grid.Column="0"
                        Style="{StaticResource MediaIconButtonStyle}"
                        Click="OnPreviousTrackClick"
                        AutomationProperties.Name="上一首"
                        ToolTip="上一首（Ctrl+Alt+Left）">
                    <Viewbox Width="19" Height="19">
                        <Canvas Width="24" Height="24">
                            <Path Data="M5,5 H7.5 V19 H5 Z M9,12 L19,5 V19 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button x:Name="TogglePlayPauseButton"
                        Grid.Column="1"
                        Style="{StaticResource MediaPrimaryButtonStyle}"
                        Click="OnTogglePlayPauseClick"
                        AutomationProperties.Name="播放或暂停"
                        ToolTip="播放 / 暂停（Ctrl+Alt+P）">
                    <Grid Width="20" Height="20">
                        <Viewbox x:Name="PlayGlyph">
                            <Canvas Width="24" Height="24">
                                <Path Data="M7.5,4.5 L20,12 L7.5,19.5 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Canvas>
                        </Viewbox>
                        <Viewbox x:Name="PauseGlyph" Visibility="Collapsed">
                            <Canvas Width="24" Height="24">
                                <Path Data="M6.5,5 H10.5 V19 H6.5 Z M13.5,5 H17.5 V19 H13.5 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Button>

                <Button x:Name="NextTrackButton"
                        Grid.Column="2"
                        Style="{StaticResource MediaIconButtonStyle}"
                        Click="OnNextTrackClick"
                        AutomationProperties.Name="下一首"
                        ToolTip="下一首（Ctrl+Alt+Right）">
                    <Viewbox Width="19" Height="19">
                        <Canvas Width="24" Height="24">
                            <Path Data="M5,5 L15,12 L5,19 Z M16.5,5 H19 V19 H16.5 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Canvas>
                    </Viewbox>
                </Button>

            </Grid>
        </Border>

        <Button x:Name="EdgeDockHandle"
                Panel.ZIndex="20"
                Width="12"
                Height="78"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Focusable="False"
                IsHitTestVisible="True"
                Visibility="Collapsed"
                MouseEnter="OnEdgeDockHandleMouseEnter"
                AutomationProperties.Name="唤出洛天依">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderThickness="0">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="FullBodyModeMenuItem"
                          Header="完整全身互动模式"
                          IsCheckable="True"
                          Click="OnToggleDisplayMode" />
                <MenuItem Header="动画与状态验证">
                    <MenuItem Header="模拟开始播放音乐" Click="OnPreviewMusicStart" />
                    <MenuItem Header="模拟停止音乐" Click="OnPreviewMusicStop" />
                    <MenuItem x:Name="BodyHitDebugMenuItem"
                              Header="显示身体区域调试层"
                              IsCheckable="True"
                              Click="OnToggleBodyHitDebug" />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="ExitMenuItem" Header="退出桌宠" Click="OnExitClick" />
            </ContextMenu>
        </Grid.ContextMenu>
    </Grid>
</Window>
