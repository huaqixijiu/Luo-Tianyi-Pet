<Window x:Class="LuoTianyiPet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="洛天依桌宠"
        Width="196"
        Height="196"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        Loaded="OnLoaded"
        Closed="OnClosed"
        MouseLeftButtonDown="OnMouseLeftButtonDown">
    <Grid x:Name="Root">
        <Grid x:Name="PetVisual"
              Margin="8"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="PetShakeTransform" />
            </Grid.RenderTransform>

            <Image x:Name="PetImage"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SnapsToDevicePixels="True"
                   Stretch="Fill" />

            <Border x:Name="FallbackSurface"
                    Width="180"
                    Height="180"
                    Padding="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="#E833B9D0"
                    BorderBrush="#EEFFFFFF"
                    BorderThickness="3"
                    CornerRadius="90"
                    Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="34"
                               Text="♪" />
                    <TextBlock Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="动画素材暂时不可用" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="FullBodyModeMenuItem"
                          Header="完整全身互动模式"
                          IsCheckable="True"
                          Click="OnToggleDisplayMode" />
                <MenuItem Header="动画与状态验证">
                    <MenuItem Header="模拟开始播放音乐" Click="OnPreviewMusicStart" />
                    <MenuItem Header="模拟停止音乐" Click="OnPreviewMusicStop" />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="TopmostMenuItem"
                          Header="始终置顶"
                          IsCheckable="True"
                          Click="OnToggleTopmost" />
                <Separator />
                <MenuItem x:Name="ExitMenuItem" Header="退出桌宠" Click="OnExitClick" />
            </ContextMenu>
        </Grid.ContextMenu>
    </Grid>
</Window>
