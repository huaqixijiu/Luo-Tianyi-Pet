<Window x:Class="LuoTianyiPet.App.MessageNotificationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="消息提醒" Width="212" Height="82" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False" IsHitTestVisible="False" WindowStartupLocation="Manual">
        <Border x:Name="MessageNotificationBubble"
                Panel.ZIndex="8"
                Width="188"
                Height="58"
                Margin="12"
                Padding="8,6"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#F4F7FCFF"
                BorderBrush="#D966CCFF"
                BorderThickness="1"
                CornerRadius="15"
                IsHitTestVisible="False"
                Visibility="Visible"
                AutomationProperties.Name="聊天消息提醒">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12"
                                  Color="#FF0A719D"
                                  Direction="270"
                                  Opacity="0.34"
                                  ShadowDepth="3" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Width="42"
                      Height="42"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center">
                    <Border x:Name="MessagePrimaryIconSurface"
                            Background="#FF66CCFF"
                            BorderBrush="White"
                            BorderThickness="1"
                            CornerRadius="21"
                            ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="MessageProviderGlyph"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Text="Q" />
                            <Image x:Name="MessagePrimaryIcon"
                                   Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <Border x:Name="MessageAppBadge"
                            Width="19"
                            Height="19"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="White"
                            BorderBrush="#FF66CCFF"
                            BorderThickness="1"
                            CornerRadius="9.5"
                            ClipToBounds="True"
                            Visibility="Collapsed">
                        <Image x:Name="MessageAppBadgeIcon"
                               Margin="2"
                               Stretch="Uniform" />
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1"
                            Margin="3,1,2,0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="MessageSourceText"
                               Foreground="#FF397B9A"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Text="QQ · 新消息" />
                    <TextBlock x:Name="MessageConversationText"
                               Margin="0,1,0,0"
                               Foreground="#FF18394A"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Text="有新消息"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MessagePreviewText" Margin="0,4,0,0" Foreground="#FF456574"
                               FontSize="12" LineHeight="17" MaxHeight="36" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>


</Window>