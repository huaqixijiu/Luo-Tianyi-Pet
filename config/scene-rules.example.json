        "loopCount": 1
      },
      "chestAndLowerBodySensitiveRegions": {
        "regions": [
          "chest",
          "lower-body-sensitive-area"
        ],
        "firstClickAnimation": "resonance-guilty",
        "repeatClickAnimation": "resonance-dark",
        "firstClickEffectivePlaybackRate": 0.8,
        "repeatClickEffectivePlaybackRate": 0.6,
        "repeatWithinMilliseconds": 4000,
        "cooldownAfterRepeatMilliseconds": 10000,
        "shareRepeatWindowAcrossRegions": true
      },
      "feet": {
        "regions": [
          "left-foot",
          "right-foot"
        ],
        "firstClickAnimation": "tenth-anniversary-oops-shake",
        "mirrorFirstClickByRegion": ["left-foot"],
        "secondConsecutiveClickAnimation": "twelfth-anniversary-stop",
        "repeatWithinMilliseconds": 4000,
        "motion": "shake",
        "loopCount": 1,
        "resetPairWhenAnotherBodyPartIsClicked": true
      },
      "ordinaryBody": {
        "matchWhenNoSmallerRegionMatches": true,
        "selectionMode": "random-without-immediate-repeat",
        "animations": [
          "twelfth-anniversary-hug"
        ],
        "loopCount": 1
      }
    },
    "drag": {
      "button": "left",
      "startAfterPixels": 6,
      "preserveMediumIdleHeheDuringDrag": true,
      "preserveMediumIdleHeheAfterDrop": true,
      "singleClickStillExitsMediumIdleHehe": true,
      "whileMusicPlaying": {
        "animation": "keep-current-music-animation",
        "replaceCurrentAnimation": false,
        "playLandingAnimationOnDrop": false
      },
      "behaviorByAppearanceStyle": {
        "full-body-classic-cat-ears": {
          "animation": "resonance-expand",
          "replaceCurrentAnimation": true,
          "matchCurrentAppearanceDisplaySize": true,
          "preserveSourceAspectRatioWithTransparentPadding": true,
          "loopWhileDragging": false,
          "holdLastFrameAfterOnePlay": true,
          "rapidBackAndForthEasterEgg": {
            "animation": "tenth-anniversary-spin-dance",
            "minimumLegDistanceDips": 32,
            "minimumLegVelocityDipsPerSecond": 360,
            "requiredDirectionChanges": 4,
            "maximumSequenceMilliseconds": 1400,
            "loopUntilNextClick": true
