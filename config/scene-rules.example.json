{
  "schemaVersion": 1,
  "window": {
    "userTopmostDefault": false,
    "neverActivateForTransientEvents": true,
    "suppressTransientTopmostInFullscreen": true
  },
  "applicationExit": {
    "userRequestedExit": {
      "animation": "resonance-cracked-shake",
      "motion": "shake",
      "loopCount": 1,
      "maximumDurationMilliseconds": 850
    },
    "skipAnimationForSystemShutdownLogoffOrCrash": true
  },
  "safety": {
    "safeGameMode": true,
    "noAdministratorPrivileges": true,
    "noProcessMemoryAccess": true,
    "noDllInjection": true,
    "noGraphicsHooks": true,
    "noNetworkInspection": true,
    "disableSyntheticInputWhileProtectedAppForeground": true,
    "protectedProcesses": [
      "YuanShen.exe",
      "GenshinImpact.exe"
    ]
  },
  "idle": {
    "shortIdleAfterSeconds": 45,
    "mediumIdleAfterSeconds": 300,
    "sleepAfterSeconds": 900,
    "keepDancingWhileMusicIsPlaying": true,
    "musicTemporarilyOverridesSelectedDisplayMode": true,
    "defaultDisplayMode": "compact",
    "rememberLastDisplayModeOnRestart": false,
    "restoreSelectedDisplayModeAfterTransientAnimation": true,
    "displayModeToggle": {
      "gesture": "double-left-click",
      "maximumIntervalMilliseconds": 300,
      "suppressPendingSingleClickWhenToggled": true
    },
    "displayModes": {
      "compact": {
        "idleAnimation": "resonance-hehe",
        "bodyRegionInteractionsEnabled": false
      },
      "fullBodyInteractive": {
        "idleAnimation": "official-v4-chibi-full-body-idle",
        "bodyRegionInteractionsEnabled": true
      }
    },
    "musicPlayingIdleAnimation": "ninth-anniversary-music-sway",
    "mediumIdleAnimation": "twelfth-anniversary-lie-flat",
    "birthdayIdleEasterEgg": {
      "animation": "twelfth-anniversary-happy-birthday",
      "dates": ["07-12", "12-12"],
      "minimumIntervalMinutes": 45,
      "maximumIntervalMinutes": 90,
      "onlyWhileIdle": true
    },
    "sleepAnimation": "tenth-anniversary-goodnight-float"
  },
  "volume": {
    "controlMethods": [
      "pet-mouse-wheel",
      "pet-menu-slider",
      "external-system-volume-events"
    ],
    "increaseAnimation": "resonance-voice",
    "decreaseAnimation": {
      "id": "resonance-voice-reversed",
      "asset": "assets/animations/processed/心律共鸣_共鸣之声_倒放.gif",
      "transformation": "reverse-frame-order"
    },
    "muteAnimation": null,
    "unmuteAnimation": null,
    "mergeChangesWithinMilliseconds": 500,
    "cooldownMilliseconds": 2000,
    "showPercentageBubble": true
  },
  "media": {
    "targetProcess": "cloudmusic.exe",
    "commandMode": "user-configured-global-shortcuts",
    "detectAudioWithCoreAudio": true,
    "pollIntervalMilliseconds": 250,
    "audiblePeakThreshold": 0.001,
    "silenceGraceMilliseconds": 1000,
    "preserveLastStateWhenProbeTemporarilyUnavailable": true,
    "disableCommandsInSafeGameMode": true,
    "trackInfo": {
      "sourcePriority": [
        "windows-system-media-session",
        "cloudmusic-main-window-caption"
      ],
      "pollIntervalMilliseconds": 1000,
      "showOnPointerHover": true,
      "showAfterTrackChangeMilliseconds": 4000,
      "placement": "above-animation",
      "reservedHeightDips": 52,
      "persistHistory": false,
      "writeTitleToLogs": false
    },
    "controlSurface": {
      "presentation": "hover-overlay",
      "hideWhenPointerLeaves": true,
      "placement": "below-animation",
      "reservedHeightDips": 58,
      "keepPetWindowSize": false,
      "theme": {
        "primaryColor": "#66CCFF",
        "surface": "tianyi-blue-tinted-glass",
        "icons": "local-vector-paths",
        "useThirdPartyUiFramework": false
      },
      "motion": {
        "showDurationMilliseconds": 170,
        "hideDelayMilliseconds": 220,
        "hideDurationMilliseconds": 120,
        "translateFromBottomPixels": 8
      },
      "buttons": [
        "previousTrack",
        "togglePlayPause",
        "nextTrack",
        "favoriteTrack"
      ],
      "showCurrentShortcutInTooltip": true
    },
    "globalShortcuts": {
      "enabled": true,
      "previousTrack": "Ctrl+Alt+Left",
      "togglePlayPause": "Ctrl+Alt+P",
      "nextTrack": "Ctrl+Alt+Right",
      "favoriteTrack": "Ctrl+Alt+L",
      "minimumIntervalMilliseconds": 350,
      "rejectWhenRelevantKeyIsAlreadyDown": true,
      "reportSentSeparatelyFromConfirmedSuccess": true
    },
    "playingAnimations": {
      "selectionMode": "random-per-playing-session",
      "selectAgainAfterPause": true,
      "loopSelectedAnimation": true,
      "candidates": [
        {
          "id": "resonance-enjoy-music",
          "playbackRate": 0.5,
          "asset": "assets/animations/processed/心律共鸣_享受音乐_无缝_0.5x.gif"
        },
        {
          "id": "ninth-anniversary-music-sway",
          "playbackRate": 1.0,
          "asset": "候选素材_官方/00_快速预览/02_九周年_音乐摇摆.webp"
        }
      ]
    },
    "loadingAnimation": "resonance-loading-sway",
    "showLoadingAfterMilliseconds": 400,
    "loadingTimeoutMilliseconds": 15000,
    "timeoutFeedback": "failureOrTimeout",
    "confirmedSuccessAnimation": "resonance-ok",
    "pauseAnimation": "ninth-anniversary-not-awake-breathing",
    "pauseAnimationDurationMilliseconds": 5000,
    "resumeInterruptsPauseAnimation": true
  },
  "pointerInteractions": {
    "hitTesting": {
      "mode": "alpha-mask-and-normalized-body-regions",
      "clickMaximumMovementPixels": 6,
      "priority": [
        "pet-window-drag",
        "head-petting-gesture",
        "smallest-body-hit-region"
      ]
    },
    "bodyRegions": {
      "recoveryDelayAfterAnimationMilliseconds": 800,
      "recoveryDelayBlocks": [
        "single-body-click",
        "head-petting-gesture"
      ],
      "recoveryDelayAllows": [
        "double-click-display-mode-toggle",
        "pet-window-drag"
      ],
      "enabledInDisplayModes": [
        "fullBodyInteractive"
      ],
      "mouth": {
        "gesture": "short-left-click",
        "animation": "resonance-kiss",
        "loopCount": 1
      },
      "face": {
        "gesture": "short-left-click",
        "animation": "twelfth-anniversary-stick-together",
        "loopCount": 1
      },
      "eyes": {
        "regions": [
          "left-eye",
          "right-eye"
        ],
        "animation": "resonance-soft-heart",
        "loopCount": 1,
        "takePriorityOverFaceRegion": true
      },
      "headPetting": {
        "regions": [
          "hair",
          "top-of-head"
        ],
        "gesture": "hold-and-stroke",
        "minimumDurationMilliseconds": 600,
        "animation": "resonance-cute",
        "loopCount": 1
      },
      "hands": {
        "regions": [
          "left-hand",
          "right-hand"
        ],
        "animation": "tenth-anniversary-high-five-bounce",
        "loopCount": 1
      },
      "chestAndLowerBodySensitiveRegions": {
        "regions": [
          "chest",
          "lower-body-sensitive-area"
        ],
        "firstClickAnimation": "resonance-guilty",
        "repeatClickAnimation": "resonance-dark",
        "repeatWithinMilliseconds": 4000,
        "cooldownAfterRepeatMilliseconds": 10000,
        "shareRepeatWindowAcrossRegions": true
      },
      "feet": {
        "regions": [
          "left-foot",
          "right-foot"
        ],
        "animation": "tenth-anniversary-oops-shake",
        "motion": "shake",
        "loopCount": 1,
        "escalateOnRepeat": false
      },
      "ordinaryBody": {
        "matchWhenNoSmallerRegionMatches": true,
        "animation": "twelfth-anniversary-hug",
        "loopCount": 1
      }
    },
    "drag": {
      "button": "left",
      "startAfterPixels": 6,
      "whileMusicPlaying": {
        "animation": "keep-current-music-animation",
        "replaceCurrentAnimation": false,
        "playLandingAnimationOnDrop": false
      },
      "behaviorByDisplayMode": {
        "compact": {
          "animation": "resonance-expand",
          "replaceCurrentAnimation": true,
          "loopWhileDragging": true
        },
        "fullBodyInteractive": {
          "animation": "keep-current-full-body-animation",
          "replaceCurrentAnimation": false,
          "loopWhileDragging": true
        }
      },
      "allowWindowTiltAndShadow": true
    },
    "edgeDock": {
      "snapThresholdDips": 18,
      "visibleTriggerStripDips": 12,
      "supportedEdges": ["left", "right", "bottom"],
      "left": {
        "animation": "twelfth-anniversary-peek",
        "mirrorHorizontally": true
      },
      "right": {
        "animation": "twelfth-anniversary-peek",
        "mirrorHorizontally": false
      },
      "bottom": {
        "animation": "twelfth-anniversary-entrance"
      },
      "hidePlaybackDirection": "reverse",
      "pointerEnterPlaybackDirection": "forward",
      "holdFinalFrameWhilePointerInside": true,
      "pointerLeavePlaybackDirection": "reverse"
    },
    "drop": {
      "behaviorByDisplayMode": {
        "compact": {
          "animation": "codename-landing-bounce",
          "loopCount": 1,
          "addSpringMotion": true
        },
        "fullBodyInteractive": {
          "animation": null,
          "addSpringMotion": false
        }
      },
      "returnToResolvedContinuousState": true,
      "returnToSelectedDisplayMode": true
    },
    "desktopFileDrop": {
      "enabled": true,
      "detectionMode": "window-ole-drop-target-only",
      "acceptedDataFormat": "CF_HDROP-real-filesystem-items-only",
      "proximityPaddingPixels": 72,
      "minimumHoverBeforeDropMilliseconds": 400,
      "dragEnterAnimation": "resonance-give-me",
      "showRecycleDropHighlight": true,
      "dropAction": "move-to-windows-recycle-bin",
      "shellOperation": "IFileOperation-with-allow-undo-and-recycle-on-delete",
      "loadingAnimationAfterMilliseconds": 400,
      "loadingAnimation": "resonance-loading-sway",
      "successAnimation": "resonance-ok",
      "failureFeedback": "failureOrTimeout",
      "neverPermanentlyDelete": true,
      "cancelIfRecycleBinUnsupported": true,
      "confirmFolders": true,
      "confirmWhenItemCountExceeds": 10,
      "disableWhileProtectedAppForeground": true,
      "firstUseExplanation": true
    }
  },
  "operationFeedback": {
    "failureOrTimeout": {
      "animation": "resonance-cry-shake",
      "motion": "shake",
      "loopCount": 1,
      "bubbleMessages": {
        "operationFailure": "操作失败，请再试一次",
        "timeout": "等太久了，再试一次吧",
        "mediaNoResponse": "网易云没有响应",
        "recycleFailure": "没有放进回收站，文件还在原处"
      },
      "returnToResolvedContinuousState": true
    }
  },
  "startupTimeScenes": [
    {
      "id": "morning",
      "start": "06:00",
      "end": "12:00",
      "animation": "collection-good-morning-float"
    },
    {
      "id": "lunch",
      "start": "12:00",
      "end": "13:30",
      "animation": "tenth-anniversary-meal-bounce"
    },
    {
      "id": "afternoon",
      "start": "13:30",
      "end": "20:00",
      "animation": "tenth-anniversary-slacking-float"
    },
    {
      "id": "night",
      "start": "20:00",
      "end": "06:00",
      "spansMidnight": true,
      "animation": "codename-sleeping-breathing"
    }
  ],
  "genshinLaunch": {
    "enabled": true,
    "processNames": [
      "YuanShen.exe",
      "GenshinImpact.exe"
    ],
    "detectionMode": "windows-process-lifecycle-event-only",
    "animation": "resonance-no-playing",
    "loopCount": 3,
    "requestTransientTopmost": true,
    "neverActivateWindow": true,
    "triggerOncePerProcessLifetime": true,
    "postponeOrSkipWhenExclusiveFullscreen": true
  },
  "genshinBackgroundCameo": {
    "enabled": true,
    "processNames": [
      "YuanShen.exe",
      "GenshinImpact.exe"
    ],
    "detectionMode": "windows-process-presence-and-foreground-process-only",
    "onlyWhenGameIsRunningAndNotForeground": true,
    "animation": "resonance-please",
    "loopCount": 1,
    "schedule": {
      "mode": "one-random-trigger-per-background-active-hour",
      "windowMinutes": 60,
      "randomOffsetMinimumMinutes": 5,
      "randomOffsetMaximumMinutes": 55,
      "minimumCooldownMinutes": 45,
      "postponeWhenGameReturnsToForegroundMinutes": [
        5,
        15
      ]
    },
    "position": {
      "mode": "random-within-current-monitor-work-area",
      "safeMarginPixels": 24,
      "keepEntirePetVisible": true,
      "avoidTaskbar": true,
      "restorePreviousPositionAfterPlayback": true
    },
    "requestTransientTopmost": true,
    "neverActivateWindow": true,
    "suppressWhenGameIsForegroundOrExclusiveFullscreen": true,
    "cancelPendingOnProcessExitLockOrSleep": true
  },
  "messageNotifications": {
    "animation": "codename-curious-sway",
    "loopCount": 1,
    "bubbleContent": "application-name-only",
    "deduplicateWithinMilliseconds": 3000,
    "suppressWhenSourceIsForeground": true,
    "requestTransientTopmostOnDesktop": true,
    "transientTopmostMilliseconds": 2000,
    "suppressTransientTopmostInFullscreen": true,
    "providers": [
      {
        "id": "qq",
        "displayName": "QQ",
        "processNames": [
          "QQ.exe"
        ]
      },
      {
        "id": "wechat",
        "displayName": "微信",
        "processNames": [
          "WeChat.exe",
          "Weixin.exe"
        ]
      }
    ]
  }
}
