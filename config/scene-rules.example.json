{
  "schemaVersion": 1,
  "window": {
    "userTopmostDefault": false,
    "startWithWindowsDefault": false,
    "settingsEntryPoint": "windows-system-tray",
    "trayLeftClick": "show-and-recall-pet-never-toggle-hidden",
    "trayRightClick": "show-hide-settings-exit-menu",
    "lockPositionDefault": false,
    "animationLayout": {
      "stageSizing": "catalog-max-display-size-at-user-scale",
      "artworkAlignment": "bottom-center-preserve-native-display-size",
      "islandReferenceArtworkWidthDips": 220,
      "normalEdgePlacement": "keep-stable-stage-visible",
      "dragReleasePlacement": "preserve-visible-alpha-edges-at-invisible-swap",
      "edgeDockHitTesting": "actual-alpha-and-clipped-handle"
    },
    "petRightClick": ["lockPosition", "alwaysOnTop", "showMusicIslands", "displayScale"],
    "neverActivateForTransientEvents": true,
    "suppressTransientTopmostInFullscreen": true
  },
  "appearance": {
    "fullBodyStyleDefault": "full-body-long-hair",
    "fullBodyStyleCycling": {
      "enabledDefault": true,
      "gesture": "double-left-click",
      "order": [
        "full-body-long-hair",
        "full-body-crystal-dress",
        "full-body-classic-cat-ears"
      ],
      "persistCurrentStyle": true,
      "disabledBehavior": "keep-current-style"
    },
    "fullBodyStyles": {
      "full-body-long-hair": {
        "displayName": "华裳长发版",
        "animation": "official-v4-chibi-full-body-idle",
        "interactionMode": "disabled"
      },
      "full-body-crystal-dress": {
        "displayName": "晶蓝礼服版",
        "animation": "user-chibi-crystal-full-body-idle",
        "interactionMode": "seamless-motion",
        "interactionAnimations": {
          "eyes": "crystal-cover-eyes",
          "mouth": "crystal-cover-mouth",
          "face": "crystal-pinch-cheeks",
          "hands": "crystal-hand-heart",
          "feet": "crystal-touch-leg",
          "headAndHair": "crystal-headpat",
          "chest": "crystal-touch-chest",
          "lowerBodySensitiveArea": "crystal-touch-skirt",
          "otherBody": "crystal-hold-belly"
        }
      },
      "full-body-classic-cat-ears": {
        "displayName": "经典猫耳版",
        "animation": "user-chibi-classic-full-body-idle",
        "interactionMode": "expression-pack"
      }
    },
    "bunEatingEnabledDefault": true,
    "bunEatingStyleByFullBodyStyle": {
      "full-body-long-hair": "bun-eating-new",
      "full-body-crystal-dress": "bun-eating-new",
      "full-body-classic-cat-ears": "bun-eating-original"
    },
    "bunEatingStyles": {
      "bun-eating-original": {
        "displayName": "元气追包版",
        "runAnimation": "ai-bun-chase-run",
        "eatAnimation": "ai-bun-eat"
      },
      "bun-eating-new": {
        "displayName": "甜笑寻包版",
        "runAnimation": "ai-bun-v2-chase-run",
        "eatAnimation": "ai-bun-v2-eat"
      }
    },
    "displayScalePercentDefault": 100,
    "displayScalePercentMinimum": 50,
    "displayScalePercentMaximum": 200,
    "displayScaleEntryPoint": "windows-system-tray-slider"
  },
  "applicationExit": {
    "userRequestedExit": {
      "animation": "resonance-cracked-shake",
      "motion": "shake",
      "loopCount": 1,
      "maximumDurationMilliseconds": 850
    },
    "skipAnimationForSystemShutdownLogoffOrCrash": true
  },
  "safety": {
    "safeGameMode": true,
    "noAdministratorPrivileges": true,
    "noProcessMemoryAccess": true,
    "noDllInjection": true,
    "noGraphicsHooks": true,
    "noNetworkInspection": true,
    "disableSyntheticInputWhileProtectedAppForeground": true,
    "protectedProcesses": [
      "YuanShen.exe",
      "GenshinImpact.exe"
    ]
  },
  "idle": {
    "shortIdleAfterSeconds": 45,
    "sleepAfterSeconds": 1800,
    "keepDancingWhileMusicIsPlaying": true,
    "musicTemporarilyOverridesSelectedDisplayMode": true,
    "defaultDisplayMode": "fullBodyInteractive",
    "rememberLastDisplayModeOnRestart": true,
    "restoreSelectedDisplayModeAfterTransientAnimation": true,
    "legacyDisplayModeToggle": {
      "enabled": false,
      "gesture": "double-left-click",
      "maximumIntervalMilliseconds": 300,
      "suppressPendingSingleClickWhenToggled": true
    },
    "displayModes": {
      "compact": {
        "idleAnimation": "user-chibi-compact-idle",
        "bodyRegionInteractionsEnabled": false
      },
      "fullBodyInteractive": {
        "idleAnimation": "official-v4-chibi-full-body-idle",
        "bodyRegionInteractionsEnabled": true
      }
    },
    "musicPlayingIdleAnimation": "automatic-by-artist",
    "idlePollMilliseconds": 1000,
    "mediumIdleAnimation": "resonance-hehe",
    "mediumIdleByAppearance": {
      "full-body-long-hair": null,
      "full-body-crystal-dress": {
        "randomYawnAfterSeconds": 60,
        "randomYawnBeforeSeconds": 300,
        "randomYawnLatestStartSeconds": 285,
        "randomYawnMaximumPerIdleSession": 1,
        "randomYawnAnimation": "crystal-yawn",
        "countdownAnimation": null,
        "mediumIdleAfterMinutes": null,
        "longIdleAfterMinutes": 30,
        "longIdleAnimations": [
          "crystal-long-idle-sleep",
          "crystal-long-idle-duck-sit"
        ],
        "longIdleAnimationWeights": [50, 50],
        "wakeOnPetClickOnly": true,
        "decorationReselectMinutes": 5,
        "decorationAnimations": {
          "zzz": { "animation": "crystal-sleep-decoration-zzz", "weight": 60 },
          "dreamBun": { "animation": "crystal-sleep-decoration-bun", "weight": 35 },
          "dreamYuezhengLing": { "animation": "crystal-sleep-decoration-yuezhengling", "weight": 5 }
        },
        "cloudDissolveAnimation": "crystal-sleep-decoration-cloud-dissolve"
      },
      "full-body-classic-cat-ears": {
        "countdownAfterMinutes": 2,
        "countdownDurationSeconds": 60,
        "countdownUsesIndependentClock": true,
        "countdownExitOnPetClickOrDrag": true,
        "countdownIgnoreMouseMovement": true,
        "countdownPreserveOriginalWhiteBackground": false,
        "countdownAnimation": "tenth-birthday-fishing-countdown",
        "mediumIdleAfterMinutes": 3
      }
    },
    "birthdayIdleEasterEgg": {
      "animation": "twelfth-anniversary-happy-birthday",
      "dates": ["07-12", "12-12"],
      "minimumIntervalMinutes": 45,
      "maximumIntervalMinutes": 90,
      "onlyWhileIdle": true
    },
    "sleepAfterMinutes": 30,
    "sleepOnlyForAppearances": [
      "full-body-classic-cat-ears",
      "full-body-crystal-dress"
    ],
    "sleepRequiresMusicStopped": true,
    "sleepAnimation": "tenth-anniversary-goodnight-float",
    "wakeAnimation": null,
    "wakeDuplicateWindowMilliseconds": 5000
  },
  "volume": {
    "systemMasterVolumeEnabled": false,
    "settingsVisible": false,
    "petMouseWheelEnabled": false,
    "externalSystemVolumeFeedbackEnabled": false,
    "cloudMusicSessionVolume": {
      "status": "enabled-in-settings-and-hover-control-island",
      "targetProcess": "cloudmusic.exe",
      "api": "windows-core-audio-session-simple-volume",
      "enumerateAllActiveRenderDevices": true,
      "adjustAllMatchingSessions": true,
      "hoverControl": {
        "buttonPlacement": "rightmost",
        "buttonColor": "#66CCFF",
        "sliderOrientation": "vertical",
        "flyoutPlacement": "above-button"
      },
      "mustNeverFallbackToSystemMasterVolume": true
    }
  },
  "media": {
    "showMusicIslandsDefault": false,
    "musicIslandsEntryPoint": "pet-right-click-toggle",
    "persistMusicIslandsPreference": true,
    "disabledIslandsBehavior": "hide-track-controls-volume-no-mini-button-no-auto-reopen",
    "targetProcess": "cloudmusic.exe",
    "commandMode": "cloudmusic-global-shortcuts-with-public-state-confirmation",
    "detectAudioWithCoreAudio": true,
    "pollIntervalMilliseconds": 250,
    "audiblePeakThreshold": 0.001,
    "silenceGraceMilliseconds": 5000,
    "preserveLastStateWhenProbeTemporarilyUnavailable": true,
    "disableCommandsInSafeGameMode": true,
    "trackInfo": {
      "sourcePriority": [
        "windows-system-media-session",
        "cloudmusic-main-window-caption"
      ],
      "pollIntervalMilliseconds": 1000,
      "showOnPointerHover": true,
      "showAfterTrackChangeMilliseconds": 5000,
      "placement": "above-animation",
      "reservedHeightDips": 52,
      "persistHistory": false,
      "writeTitleToLogs": false
    },
    "controlSurface": {
      "presentation": "hover-overlay",
      "hideWhenPointerLeaves": true,
      "placement": "below-animation",
      "reservedHeightDips": 58,
      "keepPetWindowSize": false,
      "theme": {
        "primaryColor": "#66CCFF",
        "surface": "tianyi-blue-tinted-glass",
        "icons": "local-vector-paths",
        "useThirdPartyUiFramework": false
      },
      "motion": {
        "showDurationMilliseconds": 170,
        "hideDelayMilliseconds": 5000,
        "hideDurationMilliseconds": 120,
        "translateFromBottomPixels": 8
      },
      "buttons": [
        "previousTrack",
        "togglePlayPause",
        "nextTrack",
        "cloudMusicSessionVolume"
      ],
      "showCurrentShortcutInTooltip": true
    },
    "globalShortcuts": {
      "fallbackOnly": false,
      "enabled": true,
      "previousTrack": "Ctrl+Alt+Left",
      "togglePlayPause": "Ctrl+Alt+P",
      "nextTrack": "Ctrl+Alt+Right",
      "minimumIntervalMilliseconds": 350,
      "rejectWhenRelevantKeyIsAlreadyDown": true,
      "reportSentSeparatelyFromConfirmedSuccess": true
    },
    "coldStartFromPlayButton": {
      "enabled": true,
      "triggerOnlyWhenTargetProcessIsAbsent": true,
      "resolveExecutableFromWindowsAppPathsFirst": true,
      "knownInstallDirectoriesFallback": true,
      "minimumDispatchDelayMilliseconds": 2000,
      "waitForTrackMetadataBeforeDispatch": true,
      "metadataFallbackDelayMilliseconds": 10000,
      "retryWhenControllableWindowDoesNotAppear": true,
      "retryIntervalMilliseconds": 3000,
      "maximumLaunchAttempts": 3,
      "timeoutMilliseconds": 30000,
      "waitingAnimation": "resonance-loading-sway",
      "waitingAnimationMotion": "none-static-source-image",
      "holdWaitingTextUntilResolved": true,
      "finishWhenCoreAudioBecomesAudible": true,
      "disableInSafeGameMode": true
    },
    "playingAnimations": {
      "selectionModeDefault": "automatic-by-artist",
      "selectionSettingEntryPoint": "settings-window",
      "selectAgainAfterPause": true,
      "selectAgainAfterTrackChange": true,
      "loopSelectedAnimation": true,
      "artistRouting": {
        "otherOrUnknown": "resonance-enjoy-music",
        "yuezhengLingSoloOrCollaboration": "twelfth-anniversary-call",
        "luoTianyiSoloOrCollaboration": [
          "ninth-anniversary-music-sway",
          "newyear-one-click-singing"
        ],
        "whenBothArtistsArePresent": "luoTianyiPriority",
        "fixedChoiceAppliesToEveryArtist": true
      },
      "selectableModes": [
        "automatic-by-artist",
        "resonance-enjoy-music",
        "ninth-anniversary-music-sway",
        "newyear-one-click-singing",
        "none"
      ],
      "registeredLoopAnimations": [
        {
          "id": "resonance-enjoy-music",
          "playbackRate": 0.5,
          "asset": "assets/animations/processed/心律共鸣_享受音乐_无缝_0.5x.gif"
        },
        {
          "id": "ninth-anniversary-music-sway",
          "playbackRate": 1.0,
          "asset": "候选素材_官方/00_快速预览/02_九周年_音乐摇摆.webp"
        },
        {
          "id": "newyear-one-click-singing",
          "playbackRate": 1.0,
          "asset": "assets/animations/processed/元旦祝福_一键唱歌_无缝循环.gif"
        },
        {
          "id": "twelfth-anniversary-call",
          "playbackRate": 1.0,
          "asset": "assets/animations/runtime/twelfth-anniversary-call.frames.webp",
          "sourceCycleFrames": 14
        }
      ]
    },
    "loadingAnimation": null,
    "showLoadingAfterMilliseconds": null,
    "loadingTimeoutMilliseconds": 15000,
    "preserveMusicAnimationDuringRequestedTrackSwitch": true,
    "timeoutFeedback": "failureOrTimeout",
    "confirmedSuccessAnimation": "resonance-ok",
    "pauseAnimation": null,
    "pauseAnimationDurationMilliseconds": 0,
    "doubleClickDismissesPauseAnimation": false,
    "resumeInterruptsPauseAnimation": false,
    "userPauseFastConfirmationWindowMilliseconds": 2000
  },
  "pointerInteractions": {
    "hitTesting": {
      "mode": "alpha-mask-and-normalized-body-regions",
