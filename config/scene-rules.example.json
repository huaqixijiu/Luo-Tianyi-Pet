{
  "schemaVersion": 1,
  "window": {
    "userTopmostDefault": false,
    "startWithWindowsDefault": false,
    "settingsEntryPoint": "windows-system-tray",
    "neverActivateForTransientEvents": true,
    "suppressTransientTopmostInFullscreen": true
  },
  "appearance": {
    "fullBodyStyleDefault": "full-body-long-hair",
    "fullBodyStyles": {
      "full-body-long-hair": {
        "displayName": "华裳长发版",
        "animation": "official-v4-chibi-full-body-idle",
        "interactionMode": "disabled"
      },
      "full-body-crystal-dress": {
        "displayName": "晶蓝礼服版",
        "animation": "user-chibi-crystal-full-body-idle",
        "interactionMode": "seamless-motion-pending-assets"
      },
      "full-body-classic-cat-ears": {
        "displayName": "经典猫耳版",
        "animation": "user-chibi-classic-full-body-idle",
        "interactionMode": "expression-pack"
      }
    },
    "bunEatingStyleDefault": "bun-eating-original",
    "bunEatingStyles": {
      "bun-eating-original": {
        "displayName": "元气追包版",
        "runAnimation": "ai-bun-chase-run",
        "eatAnimation": "ai-bun-eat"
      },
      "bun-eating-new": {
        "displayName": "甜笑寻包版",
        "runAnimation": "ai-bun-v2-chase-run",
        "eatAnimation": "ai-bun-v2-eat"
      }
    },
    "displayScalePercentDefault": 100,
    "displayScalePercentMinimum": 50,
    "displayScalePercentMaximum": 200,
    "displayScaleEntryPoint": "windows-system-tray-slider"
  },
  "applicationExit": {
    "userRequestedExit": {
      "animation": "resonance-cracked-shake",
      "motion": "shake",
      "loopCount": 1,
      "maximumDurationMilliseconds": 850
    },
    "skipAnimationForSystemShutdownLogoffOrCrash": true
  },
  "safety": {
    "safeGameMode": true,
    "noAdministratorPrivileges": true,
    "noProcessMemoryAccess": true,
    "noDllInjection": true,
    "noGraphicsHooks": true,
    "noNetworkInspection": true,
    "disableSyntheticInputWhileProtectedAppForeground": true,
    "protectedProcesses": [
      "YuanShen.exe",
      "GenshinImpact.exe"
    ]
  },
  "idle": {
    "shortIdleAfterSeconds": 45,
    "mediumIdleAfterSeconds": 180,
    "sleepAfterSeconds": 1800,
    "keepDancingWhileMusicIsPlaying": true,
    "musicTemporarilyOverridesSelectedDisplayMode": true,
    "defaultDisplayMode": "compact",
    "rememberLastDisplayModeOnRestart": false,
    "restoreSelectedDisplayModeAfterTransientAnimation": true,
    "displayModeToggle": {
      "gesture": "double-left-click",
      "maximumIntervalMilliseconds": 300,
      "suppressPendingSingleClickWhenToggled": true
    },
    "displayModes": {
      "compact": {
        "idleAnimation": "user-chibi-compact-idle",
        "bodyRegionInteractionsEnabled": false
      },
      "fullBodyInteractive": {
        "idleAnimation": "official-v4-chibi-full-body-idle",
        "bodyRegionInteractionsEnabled": true
      }
    },
    "musicPlayingIdleAnimation": "ninth-anniversary-music-sway",
    "idlePollMilliseconds": 1000,
    "mediumIdleAfterMinutes": 3,
    "mediumIdleAnimation": "resonance-hehe",
    "mediumIdleEligibility": {
      "displayMode": "fullBodyInteractive",
      "fullBodyStyle": "full-body-classic-cat-ears"
    },
    "birthdayIdleEasterEgg": {
      "animation": "twelfth-anniversary-happy-birthday",
      "dates": ["07-12", "12-12"],
      "minimumIntervalMinutes": 45,
      "maximumIntervalMinutes": 90,
      "onlyWhileIdle": true
    },
    "sleepAfterMinutes": 30,
    "sleepRequiresMusicStopped": true,
    "sleepAnimation": "tenth-anniversary-goodnight-float",
    "wakeAnimation": null,
    "wakeDuplicateWindowMilliseconds": 5000
  },
  "volume": {
    "systemMasterVolumeEnabled": false,
    "settingsVisible": false,
    "petMouseWheelEnabled": false,
    "externalSystemVolumeFeedbackEnabled": false,
    "cloudMusicSessionVolume": {
      "status": "enabled-in-settings-and-hover-control-island",
      "targetProcess": "cloudmusic.exe",
      "api": "windows-core-audio-session-simple-volume",
      "enumerateAllActiveRenderDevices": true,
      "adjustAllMatchingSessions": true,
      "hoverControl": {
        "buttonPlacement": "rightmost",
        "buttonColor": "#66CCFF",
        "sliderOrientation": "vertical",
        "flyoutPlacement": "above-button"
      },
      "mustNeverFallbackToSystemMasterVolume": true
    }
  },
  "media": {
    "targetProcess": "cloudmusic.exe",
    "commandMode": "user-configured-global-shortcuts",
    "detectAudioWithCoreAudio": true,
    "pollIntervalMilliseconds": 250,
    "audiblePeakThreshold": 0.001,
    "silenceGraceMilliseconds": 1000,
    "preserveLastStateWhenProbeTemporarilyUnavailable": true,
    "disableCommandsInSafeGameMode": true,
    "trackInfo": {
      "sourcePriority": [
        "windows-system-media-session",
        "cloudmusic-main-window-caption"
      ],
      "pollIntervalMilliseconds": 1000,
      "showOnPointerHover": true,
      "showAfterTrackChangeMilliseconds": 4000,
      "placement": "above-animation",
      "reservedHeightDips": 52,
      "persistHistory": false,
      "writeTitleToLogs": false
    },
    "controlSurface": {
      "presentation": "hover-overlay",
      "hideWhenPointerLeaves": true,
      "placement": "below-animation",
      "reservedHeightDips": 58,
      "keepPetWindowSize": false,
      "theme": {
        "primaryColor": "#66CCFF",
        "surface": "tianyi-blue-tinted-glass",
        "icons": "local-vector-paths",
        "useThirdPartyUiFramework": false
      },
      "motion": {
        "showDurationMilliseconds": 170,
        "hideDelayMilliseconds": 220,
        "hideDurationMilliseconds": 120,
        "translateFromBottomPixels": 8
      },
      "buttons": [
        "previousTrack",
        "togglePlayPause",
        "nextTrack",
        "cloudMusicSessionVolume"
      ],
      "showCurrentShortcutInTooltip": true
    },
    "globalShortcuts": {
      "enabled": true,
      "previousTrack": "Ctrl+Alt+Left",
      "togglePlayPause": "Ctrl+Alt+P",
      "nextTrack": "Ctrl+Alt+Right",
      "minimumIntervalMilliseconds": 350,
      "rejectWhenRelevantKeyIsAlreadyDown": true,
      "reportSentSeparatelyFromConfirmedSuccess": true
    },
    "coldStartFromPlayButton": {
      "enabled": true,
      "triggerOnlyWhenTargetProcessIsAbsent": true,
      "resolveExecutableFromWindowsAppPathsFirst": true,
      "knownInstallDirectoriesFallback": true,
      "shortcutDispatchDelayMilliseconds": 2000,
      "timeoutMilliseconds": 30000,
      "waitingAnimation": "resonance-loading-sway",
      "waitingAnimationMotion": "none-static-source-image",
      "holdWaitingTextUntilResolved": true,
      "finishWhenCoreAudioBecomesAudible": true,
      "disableInSafeGameMode": true
    },
    "playingAnimations": {
      "selectionModeDefault": "random",
      "selectionSettingEntryPoint": "settings-window",
      "selectAgainAfterPause": true,
      "selectAgainAfterTrackChange": true,
      "loopSelectedAnimation": true,
      "selectableModes": [
        "random",
        "resonance-enjoy-music",
        "ninth-anniversary-music-sway"
      ],
      "registeredLoopAnimations": [
        {
          "id": "resonance-enjoy-music",
          "playbackRate": 0.5,
          "asset": "assets/animations/processed/心律共鸣_享受音乐_无缝_0.5x.gif"
        },
        {
          "id": "ninth-anniversary-music-sway",
          "playbackRate": 1.0,
          "asset": "候选素材_官方/00_快速预览/02_九周年_音乐摇摆.webp"
        }
      ]
    },
    "loadingAnimation": null,
    "showLoadingAfterMilliseconds": null,
    "loadingTimeoutMilliseconds": 15000,
    "timeoutFeedback": "failureOrTimeout",
    "confirmedSuccessAnimation": "resonance-ok",
    "pauseAnimation": "ninth-anniversary-not-awake-breathing",
    "pauseAnimationDurationMilliseconds": 60000,
    "doubleClickDismissesPauseAnimation": true,
    "resumeInterruptsPauseAnimation": true,
    "userPauseFastConfirmationWindowMilliseconds": 2000
  },
  "pointerInteractions": {
    "hitTesting": {
      "mode": "alpha-mask-and-normalized-body-regions",
      "clickMaximumMovementPixels": 6,
      "priority": [
        "pet-window-drag",
        "head-petting-gesture",
        "smallest-body-hit-region"
      ]
    },
    "bodyRegions": {
      "recoveryDelayAfterAnimationMilliseconds": 800,
      "recoveryDelayBlocks": [
        "single-body-click",
        "head-petting-gesture"
      ],
      "recoveryDelayAllows": [
        "double-click-display-mode-toggle",
        "pet-window-drag"
      ],
      "enabledInDisplayModes": [
        "fullBodyInteractive"
      ],
      "mouth": {
        "gesture": "short-left-click",
        "animation": "resonance-kiss",
        "loopCount": 1
      },
      "face": {
        "gesture": "short-left-click",
        "animation": "twelfth-anniversary-stick-together",
        "loopCount": 1
      },
      "eyes": {
        "regions": [
          "left-eye",
          "right-eye"
        ],
        "animation": "resonance-soft-heart",
        "loopCount": 1,
        "takePriorityOverFaceRegion": true
      },
      "headPetting": {
        "regions": [
          "hair",
          "top-of-head"
        ],
        "gesture": "short-click-or-hold-and-stroke",
        "minimumDurationMilliseconds": 350,
        "minimumStrokeDistanceDips": 24,
        "minimumDirectionChanges": 1,
        "animation": "guoyue-headpat",
        "loopCount": 1
      },
      "hands": {
        "regions": [
          "left-hand",
          "right-hand"
        ],
        "animation": "tenth-anniversary-high-five-bounce",
        "loopCount": 1
      },
      "chestAndLowerBodySensitiveRegions": {
        "regions": [
          "chest",
          "lower-body-sensitive-area"
        ],
        "firstClickAnimation": "resonance-guilty",
        "repeatClickAnimation": "resonance-dark",
        "repeatWithinMilliseconds": 4000,
        "cooldownAfterRepeatMilliseconds": 10000,
        "shareRepeatWindowAcrossRegions": true
      },
      "feet": {
        "regions": [
          "left-foot",
          "right-foot"
        ],
        "animation": "tenth-anniversary-oops-shake",
        "motion": "shake",
        "loopCount": 1,
        "escalateOnRepeat": false
      },
      "ordinaryBody": {
        "matchWhenNoSmallerRegionMatches": true,
        "selectionMode": "random-without-immediate-repeat",
        "animations": [
          "twelfth-anniversary-hug"
        ],
        "loopCount": 1
      }
    },
    "drag": {
      "button": "left",
      "startAfterPixels": 6,
      "whileMusicPlaying": {
        "animation": "keep-current-music-animation",
        "replaceCurrentAnimation": false,
        "playLandingAnimationOnDrop": false
      },
      "behaviorByDisplayMode": {
        "compact": {
          "animation": "resonance-expand",
          "replaceCurrentAnimation": true,
          "loopWhileDragging": false,
          "holdLastFrameAfterOnePlay": true
        },
        "fullBodyInteractive": {
          "animation": "keep-current-full-body-idle",
          "replaceCurrentAnimation": false,
          "loopWhileDragging": false
        }
      },
      "allowWindowTiltAndShadow": true
    },
    "edgeDock": {
      "hideActivationDepthDips": 28,
      "hideReleaseDepthDips": 14,
      "dragOverscanDips": 96,
      "useStableDragReferenceBounds": true,
      "allowFlushPlacementWithoutHiding": true,
      "supportedEdges": ["left", "right", "bottom"],
      "previewAnimationImmediatelyWhileDraggingAtEdge": true,
      "hiddenTriggerUsesSourceArtwork": true,
      "bottomControlsLayoutDistanceDips": 80,
      "bottomControlsPlacement": "above-track-info",
      "left": {
        "animation": "twelfth-anniversary-peek",
        "mirrorHorizontally": true,
        "hiddenFrameIndex": 3,
        "hideStartFrameIndex": 7,
        "revealEndFrameIndex": 19,
        "hidePlaybackRate": 1.0,
        "revealPlaybackRate": 1.3,
        "runtimeCropAfterResize": [0, 0, 196, 240],
        "runtimeDisplayWidthDips": 155,
        "hiddenWallClipLeftRatio": 0.9,
        "hiddenWallClipWidthRatio": 0.092
      },
      "right": {
        "animation": "twelfth-anniversary-peek",
        "mirrorHorizontally": false,
        "hiddenFrameIndex": 3,
        "hideStartFrameIndex": 7,
        "revealEndFrameIndex": 19,
        "hidePlaybackRate": 1.0,
        "revealPlaybackRate": 1.3,
        "runtimeCropAfterResize": [0, 0, 196, 240],
        "runtimeDisplayWidthDips": 155,
        "hiddenWallClipLeftRatio": 0.9,
        "hiddenWallClipWidthRatio": 0.092
      },
      "bottom": {
        "animation": "twelfth-anniversary-entrance",
        "hiddenFrameIndex": 3,
        "hideStartFrameIndex": 5,
        "revealEndFrameIndex": 7,
        "hidePlaybackRate": 0.7,
        "revealPlaybackRate": 1.0
      },
      "hidePlaybackRoute": "clean-no-text-segment",
      "pointerEnterPlaybackRoute": "full-reveal-segment",
      "reverseFromCurrentFrameWhenDirectionChanges": true,
      "holdFinalFrameWhilePointerInside": true,
      "pointerLeavePlaybackDirection": "reverse"
    },
    "drop": {
      "behaviorByDisplayMode": {
        "compact": {
          "routineReleaseAnimation": null,
          "routineReleaseTransition": "pulse-swap-to-resolved-state",
          "fastDownwardFling": {
            "animation": "codename-landing-bounce",
            "minimumTotalDropDips": 72,
            "minimumRecentDropDips": 22,
            "minimumRecentVelocityDipsPerSecond": 650,
            "recentWindowMilliseconds": 180,
            "loopCount": 1,
            "addSpringMotion": true
          }
        },
        "fullBodyInteractive": {
          "animation": null,
          "addSpringMotion": false
        }
      },
      "returnToResolvedContinuousState": true,
      "returnToSelectedDisplayMode": true
    },
    "desktopFileDrop": {
      "enabled": true,
      "detectionMode": "window-ole-drop-target-only",
      "acceptedDataFormat": "CF_HDROP-real-filesystem-items-only",
      "promptRegion": "pet-window-including-transparent-reserved-area",
      "dropRegion": "current-visible-pet-image-bounds",
      "minimumHoverBeforeDropMilliseconds": 400,
      "dragEnterAnimation": "resonance-give-me",
      "playPromptOnceAndHoldLastFrame": true,
      "showRecycleDropHighlight": false,
      "dropAction": "move-to-windows-recycle-bin",
      "shellOperation": "IFileOperation-with-allow-undo-and-recycle-on-delete",
      "loadingAnimationAfterMilliseconds": null,
      "loadingAnimation": null,
      "successAnimation": "resonance-ok",
      "failureFeedback": "failureOrTimeout",
      "neverPermanentlyDelete": true,
      "cancelIfRecycleBinUnsupported": true,
      "confirmFolders": true,
      "confirmWhenItemCountExceeds": 10,
      "disableWhileProtectedAppForeground": true,
      "firstUseExplanation": true
    }
  },
  "operationFeedback": {
    "failureOrTimeout": {
      "animation": "resonance-cry-shake",
      "motion": "shake",
      "loopCount": 1,
      "bubbleMessages": {
        "operationFailure": "操作失败，请再试一次",
        "timeout": "等太久了，再试一次吧",
        "mediaNoResponse": "网易云没有响应",
        "recycleFailure": "没有放进回收站，文件还在原处"
      },
      "returnToResolvedContinuousState": true
    }
  },
  "startupTimeScenes": [
    {
      "id": "morning",
      "start": "06:00",
      "end": "12:00",
      "animation": "collection-good-morning-float",
      "presentationSeconds": 30,
      "triggerOnAppStartup": true,
      "triggerOnBoundary": true
    },
    {
      "id": "lunch",
      "start": "12:00",
      "end": "13:30",
      "animation": "tenth-anniversary-meal-bounce",
      "presentationSeconds": 30,
      "triggerOnAppStartup": true,
      "triggerOnBoundary": true
    },
    {
      "id": "afternoon",
      "start": "13:30",
      "end": "20:00",
      "animation": "tenth-anniversary-slacking-float",
      "presentationSeconds": 30,
      "triggerOnAppStartup": true,
      "triggerOnBoundary": true
    },
    {
      "id": "night",
      "start": "20:00",
      "end": "06:00",
      "spansMidnight": true,
      "animation": "startup-night-breathe",
      "presentationSeconds": 30,
      "triggerOnAppStartup": true,
      "triggerOnBoundary": true
    }
  ],
  "systemResume": {
    "sources": [
      "windows-session-unlock",
      "windows-power-resume"
    ],
    "animation": null,
    "duplicateWindowMilliseconds": 5000,
    "loopCount": 1,
    "preserveSelectedDisplayMode": true,
    "neverActivateWindow": true
  },
  "genshinLaunch": {
    "enabled": true,
    "processNames": [
      "YuanShen.exe",
      "GenshinImpact.exe"
    ],
    "detectionMode": "filtered-low-frequency-process-enumeration",
    "pollIntervalMilliseconds": 2000,
    "animation": "resonance-no-playing",
    "loopCount": 1,
    "holdLastFrame": true,
    "minimumTotalDurationMilliseconds": 5000,
    "requestTransientTopmost": true,
    "neverActivateWindow": true,
    "triggerOncePerProcessLifetime": true,
    "postponeOrSkipWhenExclusiveFullscreen": true
  },
  "genshinBackgroundCameo": {
    "enabled": true,
    "processNames": [
      "YuanShen.exe",
      "GenshinImpact.exe"
    ],
    "detectionMode": "windows-process-presence-and-foreground-process-only",
    "onlyWhenGameIsRunningAndNotForeground": true,
    "animation": "resonance-please",
    "loopCount": 1,
    "schedule": {
      "mode": "one-random-trigger-per-background-active-hour",
      "windowMinutes": 60,
      "randomOffsetMinimumMinutes": 5,
      "randomOffsetMaximumMinutes": 55,
      "minimumCooldownMinutes": 45,
      "postponeWhenGameReturnsToForegroundMinutes": [
        5,
        15
      ]
    },
    "position": {
      "mode": "random-within-current-monitor-work-area",
      "safeMarginPixels": 24,
      "keepEntirePetVisible": true,
      "avoidTaskbar": true,
      "restorePreviousPositionAfterPlayback": true
    },
    "requestTransientTopmost": true,
    "neverActivateWindow": true,
    "suppressWhenGameIsForegroundOrExclusiveFullscreen": true,
    "cancelPendingOnProcessExitLockOrSleep": true
  },
  "desktopFileTreats": {
    "enabled": true,
    "source": "user-and-public-desktop-filesystem-disappearance-with-uia-icon-position-cache",
    "readFileContents": false,
    "persistNamesOrPaths": false,
    "maximumQueuedBuns": 6,
    "bunCanBeDraggedBeforeEating": true,
    "trackLiveBunPosition": true,
    "processNearestFirst": true,
    "returnToOriginalPosition": true,
    "animationStyleSource": "settings.appearance.bunEatingStyle",
    "directDropFileOperation": "windows-shell-recycle-bin-only",
    "cancelOnFullscreenProtectedGameLockOrForegroundCheckFailure": true
  },
  "messageNotifications": {
    "source": "windows-user-notification-listener",
    "requiresPackageIdentity": true,
    "requiresExplicitUserConsent": true,
    "unpackagedBehavior": "unavailable-with-explanation",
    "readFields": [
      "app-user-model-id",
      "application-display-name",
      "creation-time",
      "application-logo",
      "first-title-element-only-when-separate-body-element-exists"
    ],
    "neverRead": [
      "message-body-value",
      "notification-actions",
      "chat-database-or-cache",
      "remote-avatar-url"
    ],
    "contactAvatar": "not-exposed-by-user-notification-api-fallback-to-application-logo",
    "animation": "codename-curious-sway",
    "loopCount": 1,
    "bubbleContent": "application-logo-and-conversation-title-with-source-only-fallback",
    "deduplicateWithinMilliseconds": 3000,
    "suppressWhenSourceIsForeground": true,
    "requestTransientTopmostOnDesktop": true,
    "transientTopmostMilliseconds": 2000,
    "suppressTransientTopmostInFullscreen": true,
    "providers": [
      {
        "id": "qq",
        "displayName": "QQ",
        "processNames": [
          "QQ.exe"
        ]
      },
      {
        "id": "wechat",
        "displayName": "微信",
        "processNames": [
          "WeChat.exe",
          "Weixin.exe"
        ]
      }
    ]
  }
}
