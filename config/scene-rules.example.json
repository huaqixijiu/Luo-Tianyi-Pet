    "bodyRegions": {
      "geometryByAppearanceStyle": {
        "full-body-classic-cat-ears": {
          "mode": "normalized-polygons",
          "source": "assets/body-hit-maps/full-body-classic.json",
          "fallback": "built-in-rectangles"
        },
        "full-body-crystal-dress": {
          "mode": "normalized-polygons",
          "source": "assets/body-hit-maps/full-body-crystal.json",
