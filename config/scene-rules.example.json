        "compiledStrokeCount": 3,
        "compiledFrameDurationScale": 0.8,
        "loopCount": 1
      },
      "hands": {
        "regions": [
          "left-hand",
          "right-hand"
        ],
        "animation": "tenth-anniversary-high-five-bounce",
