<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 rescap">
  <Identity
    Name="LuoTianyiPet.Dev"
    Publisher="CN=LuoTianyiPet Development"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>洛天依桌宠</DisplayName>
    <PublisherDisplayName>洛天依桌宠开发版</PublisherDisplayName>
    <Description>Windows 本地洛天依桌宠</Description>
    <Logo>assets\package\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="zh-cn" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Applications>
    <Application
      Id="App"
      Executable="LuoTianyiPet.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="洛天依桌宠"
        Description="Windows 本地洛天依桌宠"
        BackgroundColor="transparent"
        Square150x150Logo="assets\package\Square150x150Logo.png"
        Square44x44Logo="assets\package\Square44x44Logo.png" />
    </Application>
  </Applications>
  <Capabilities>
    <uap3:Capability Name="userNotificationListener" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
